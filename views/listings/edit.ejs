<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

    <div class="col-9 col-md-8 col-lg-7">

        <h3>Edit Listing</h3>


        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=PUT"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data"
        >


            <!-- Title -->

            <div class="mt-3">

                <label
                    for="title"
                    class="form-label"
                >
                    Title
                </label>

                <input
                    type="text"
                    id="title"
                    name="listing[title]"
                    value="<%= listing.title %>"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Title should be valid.
                </div>

                <div class="valid-feedback">
                    Title looks good!
                </div>

            </div>


            <!-- Description -->

            <div class="mt-3">

                <label
                    for="description"
                    class="form-label"
                >
                    Description
                </label>

                <textarea
                    id="description"
                    class="form-control"
                    name="listing[description]"
                    rows="5"
                    required
                ><%= listing.description %></textarea>

                <div class="invalid-feedback">
                    Description should be valid.
                </div>

            </div>


            <!-- Existing images gallery -->
            <div class="mb-3 mt-3">
                <label class="form-label fw-bold">
                    Current Listing Photos (<%= listing.images && listing.images.length > 0 ? listing.images.length : (listing.image?.url ? 1 : 0) %>)
                </label>
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <% if (listing.images && listing.images.length > 0) { %>
                        <% for (const img of listing.images) { %>
                            <div class="border rounded-3 overflow-hidden" style="width: 100px; height: 80px;">
                                <img src="<%= img.url %>" class="w-100 h-100" style="object-fit: cover;" alt="listing photo">
                            </div>
                        <% } %>
                    <% } else if (listing.image?.url) { %>
                        <div class="border rounded-3 overflow-hidden" style="width: 100px; height: 80px;">
                            <img src="<%= listing.image.url %>" class="w-100 h-100" style="object-fit: cover;" alt="listing photo">
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Upload additional/new images -->
            <div class="mb-3">
                <label
                    for="images"
                    class="form-label"
                >
                    Add Photos (Up to 5 total)
                </label>

                <input
                    type="file"
                    id="images"
                    class="form-control"
                    name="listing[images]"
                    accept="image/png, image/jpeg, image/jpg, image/webp"
                    multiple
                >

                <div class="form-text">
                    Leave empty to keep current photos. Max 5MB per photo (JPEG, PNG, WebP).
                </div>
            </div>


            <!-- Price & Max Occupancy -->
            <div class="row mt-3">

                <div class="col-md-6">
                    <label
                        for="price"
                        class="form-label"
                    >
                        Price per night (&#8377;)
                    </label>

                    <input
                        type="number"
                        id="price"
                        class="form-control"
                        name="listing[price]"
                        value="<%= listing.price %>"
                        min="0"
                        required
                    >

                    <div class="invalid-feedback">
                        Price should be valid.
                    </div>
                </div>

                <div class="col-md-6">
                    <label
                        for="maxGuests"
                        class="form-label"
                    >
                        Max Guests / Occupancy
                    </label>

                    <input
                        type="number"
                        id="maxGuests"
                        class="form-control"
                        name="listing[maxGuests]"
                        value="<%= listing.maxGuests || 4 %>"
                        min="1"
                        required
                    >

                    <div class="invalid-feedback">
                        Please specify maximum guest capacity (minimum 1).
                    </div>
                </div>

            </div>


            <!-- Country -->

            <div class="mt-3">

                <label
                    for="country"
                    class="form-label"
                >
                    Country
                </label>

                <input
                    type="text"
                    id="country"
                    class="form-control"
                    name="listing[country]"
                    value="<%= listing.country %>"
                    required
                >

                <div class="invalid-feedback">
                    Country should be valid.
                </div>

            </div>


            <!-- Location -->

            <div class="mt-3">

                <label
                    for="location"
                    class="form-label"
                >
                    Location
                </label>

                <input
                    type="text"
                    id="location"
                    name="listing[location]"
                    class="form-control"
                    value="<%= listing.location %>"
                    required
                >

                <div class="invalid-feedback">
                    Location should be valid.
                </div>

            </div>


            <!-- Category -->

            <div class="mt-3">

            <!-- Category & Cancellation Policy -->
            <div class="row mt-3">

                <div class="col-md-6">
                    <label
                        for="category"
                        class="form-label"
                    >
                        Category
                    </label>

                    <select
                        id="category"
                        name="listing[category]"
                        class="form-select"
                        required
                    >
                        <option value="" disabled>
                            Select a category
                        </option>
                        <option value="Beach" <%= listing.category === "Beach" ? "selected" : "" %>>Beach</option>
                        <option value="Farm" <%= listing.category === "Farm" ? "selected" : "" %>>Farm</option>
                        <option value="OMG" <%= listing.category === "OMG" ? "selected" : "" %>>OMG!</option>
                        <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
                        <option value="Trending" <%= listing.category === "Trending" ? "selected" : "" %>>Trending</option>
                        <option value="Lake" <%= listing.category === "Lake" ? "selected" : "" %>>Lake</option>
                        <option value="Bed & Breakfast" <%= listing.category === "Bed & Breakfast" ? "selected" : "" %>>Bed & Breakfast</option>
                    </select>

                    <div class="invalid-feedback">
                        Please select a category.
                    </div>
                </div>

                <div class="col-md-6">
                    <label
                        for="cancellationPolicy"
                        class="form-label"
                    >
                        Cancellation Policy
                    </label>

                    <select
                        id="cancellationPolicy"
                        name="listing[cancellationPolicy]"
                        class="form-select"
                        required
                    >
                        <option value="flexible" <%= (!listing.cancellationPolicy || listing.cancellationPolicy === "flexible") ? "selected" : "" %>>
                            Flexible (Full refund up to 48h before check-in)
                        </option>
                        <option value="moderate" <%= listing.cancellationPolicy === "moderate" ? "selected" : "" %>>
                            Moderate (Full refund up to 5 days before check-in)
                        </option>
                        <option value="strict" <%= listing.cancellationPolicy === "strict" ? "selected" : "" %>>
                            Strict (50% refund up to 7 days before check-in)
                        </option>
                    </select>
                </div>

            </div>


            <!-- Amenities -->
            <div class="mt-4">
                <label class="form-label fw-bold d-block">
                    Amenities
                </label>
                <div class="row g-2">
                    <% const availableAmenities = [
                        { name: "Wifi", icon: "fa-wifi" },
                        { name: "Pool", icon: "fa-person-swimming" },
                        { name: "Free parking", icon: "fa-square-parking" },
                        { name: "Air conditioning", icon: "fa-snowflake" },
                        { name: "Kitchen", icon: "fa-kitchen-set" },
                        { name: "Dedicated workspace", icon: "fa-laptop" },
                        { name: "TV", icon: "fa-tv" },
                        { name: "EV charger", icon: "fa-charging-station" }
                    ]; %>

                    <% for (const item of availableAmenities) { %>
                        <% const isChecked = listing.amenities && listing.amenities.includes(item.name); %>
                        <div class="col-md-3 col-6">
                            <div class="form-check p-2 border rounded-3 bg-light">
                                <input
                                    class="form-check-input ms-0 me-2"
                                    type="checkbox"
                                    name="listing[amenities]"
                                    value="<%= item.name %>"
                                    id="edit-amenity-<%= item.name.replace(/\s+/g, '-') %>"
                                    <%= isChecked ? "checked" : "" %>
                                >
                                <label class="form-check-label small" for="edit-amenity-<%= item.name.replace(/\s+/g, '-') %>">
                                    <i class="fa-solid <%= item.icon %> me-1 text-secondary"></i><%= item.name %>
                                </label>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>


            <!-- Submit -->

            <button
                class="btn add-btn mt-4"
                type="submit"
            >
                Save Changes
            </button>

        </form>

    </div>

</div>