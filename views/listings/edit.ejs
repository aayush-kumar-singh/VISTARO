<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

    <div class="col-9 col-md-8 col-lg-7">

        <h3>Edit Listing</h3>


        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=PUT"
            novalidate
            class="needs-validation"
            enctype="multipart/form-data"
        >


            <!-- Title -->

            <div class="mt-3">

                <label
                    for="title"
                    class="form-label"
                >
                    Title
                </label>

                <input
                    type="text"
                    id="title"
                    name="listing[title]"
                    value="<%= listing.title %>"
                    class="form-control"
                    required
                >

                <div class="invalid-feedback">
                    Title should be valid.
                </div>

                <div class="valid-feedback">
                    Title looks good!
                </div>

            </div>


            <!-- Description -->

            <div class="mt-3">

                <label
                    for="description"
                    class="form-label"
                >
                    Description
                </label>

                <textarea
                    id="description"
                    class="form-control"
                    name="listing[description]"
                    rows="5"
                    required
                ><%= listing.description %></textarea>

                <div class="invalid-feedback">
                    Description should be valid.
                </div>

            </div>


            <!-- Existing images gallery with delete option -->
            <div class="mb-3 mt-3">
                <label class="form-label fw-bold">
                    Current Listing Photos (<span id="existingPhotoCount"><%= listing.images && listing.images.length > 0 ? listing.images.length : (listing.image?.url ? 1 : 0) %></span>)
                    <small class="text-muted fw-normal ms-1">— click ✕ to remove a photo</small>
                </label>
                <div class="d-flex flex-wrap gap-2 mt-2" id="existingPhotosGrid">
                    <% const photosToShow = (listing.images && listing.images.length > 0) ? listing.images : (listing.image?.url ? [listing.image] : []); %>
                    <% for (let i = 0; i < photosToShow.length; i++) { %>
                        <% const img = photosToShow[i]; %>
                        <div class="position-relative existing-photo-item" data-filename="<%= img.filename %>" style="width: 100px; height: 80px;">
                            <div class="border rounded-3 overflow-hidden w-100 h-100">
                                <img src="<%= img.url %>" class="w-100 h-100" style="object-fit: cover; transition: opacity 0.2s;" alt="listing photo">
                            </div>
                            <!-- Delete overlay button -->
                            <button type="button"
                                class="btn btn-danger btn-sm position-absolute top-0 end-0 d-flex align-items-center justify-content-center p-0 rounded-circle shadow photo-delete-btn"
                                style="width: 22px; height: 22px; font-size: 0.65rem; margin: 3px; z-index: 5;"
                                title="Remove this photo"
                                onclick="toggleDeletePhoto(this, '<%= img.filename %>')">
                                &times;
                            </button>
                        </div>
                    <% } %>
                </div>
                <div id="deleteInputsContainer"></div>
                <small class="text-muted d-block mt-1">Removed photos will be permanently deleted when you save.</small>
            </div>

            <!-- Upload additional/new images -->
            <div class="mb-3">
                <label
                    for="images"
                    class="form-label"
                >
                    Add Photos (Up to 5 total)
                </label>

                <input
                    type="file"
                    id="images"
                    class="form-control"
                    name="listing[images]"
                    accept="image/png, image/jpeg, image/jpg, image/webp"
                    multiple
                >

                <div class="form-text">
                    Leave empty to keep current photos. Max 5MB per photo (JPEG, PNG, WebP).
                </div>
            </div>


            <!-- Price & Max Occupancy -->
            <div class="row mt-3">

                <div class="col-md-6">
                    <label
                        for="price"
                        class="form-label"
                    >
                        Price per night (&#8377;)
                    </label>

                    <input
                        type="number"
                        id="price"
                        class="form-control"
                        name="listing[price]"
                        value="<%= listing.price %>"
                        min="0"
                        required
                    >

                    <div class="invalid-feedback">
                        Price should be valid.
                    </div>
                </div>

                <div class="col-md-6">
                    <label
                        for="maxGuests"
                        class="form-label"
                    >
                        Max Guests / Occupancy
                    </label>

                    <input
                        type="number"
                        id="maxGuests"
                        class="form-control"
                        name="listing[maxGuests]"
                        value="<%= listing.maxGuests || 4 %>"
                        min="1"
                        required
                    >

                    <div class="invalid-feedback">
                        Please specify maximum guest capacity (minimum 1).
                    </div>
                </div>

            </div>


            <!-- Country -->

            <div class="mt-3">

                <label
                    for="country"
                    class="form-label"
                >
                    Country
                </label>

                <input
                    type="text"
                    id="country"
                    class="form-control"
                    name="listing[country]"
                    value="<%= listing.country %>"
                    required
                >

                <div class="invalid-feedback">
                    Country should be valid.
                </div>

            </div>


            <!-- Location -->

            <div class="mt-3">

                <label
                    for="location"
                    class="form-label"
                >
                    Location
                </label>

                <input
                    type="text"
                    id="location"
                    name="listing[location]"
                    class="form-control"
                    value="<%= listing.location %>"
                    required
                >

                <div class="invalid-feedback">
                    Location should be valid.
                </div>

            </div>


            <!-- Category -->

            <div class="mt-3">

            <!-- Category & Cancellation Policy -->
            <div class="row mt-3">

                <div class="col-md-6">
                    <label
                        for="category"
                        class="form-label"
                    >
                        Category
                    </label>

                    <select
                        id="category"
                        name="listing[category]"
                        class="form-select"
                        required
                    >
                        <option value="" disabled>
                            Select a category
                        </option>
                        <option value="Beach" <%= listing.category === "Beach" ? "selected" : "" %>>Beach</option>
                        <option value="Farm" <%= listing.category === "Farm" ? "selected" : "" %>>Farm</option>
                        <option value="OMG" <%= listing.category === "OMG" ? "selected" : "" %>>OMG!</option>
                        <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
                        <option value="Trending" <%= listing.category === "Trending" ? "selected" : "" %>>Trending</option>
                        <option value="Lake" <%= listing.category === "Lake" ? "selected" : "" %>>Lake</option>
                        <option value="Bed & Breakfast" <%= listing.category === "Bed & Breakfast" ? "selected" : "" %>>Bed & Breakfast</option>
                    </select>

                    <div class="invalid-feedback">
                        Please select a category.
                    </div>
                </div>

                <div class="col-md-6">
                    <label
                        for="cancellationPolicy"
                        class="form-label"
                    >
                        Cancellation Policy
                    </label>

                    <select
                        id="cancellationPolicy"
                        name="listing[cancellationPolicy]"
                        class="form-select"
                        required
                    >
                        <option value="flexible" <%= (!listing.cancellationPolicy || listing.cancellationPolicy === "flexible") ? "selected" : "" %>>
                            Flexible (Full refund up to 48h before check-in)
                        </option>
                        <option value="moderate" <%= listing.cancellationPolicy === "moderate" ? "selected" : "" %>>
                            Moderate (Full refund up to 5 days before check-in)
                        </option>
                        <option value="strict" <%= listing.cancellationPolicy === "strict" ? "selected" : "" %>>
                            Strict (50% refund up to 7 days before check-in)
                        </option>
                    </select>
                </div>

            </div>


            <!-- Amenities -->
            <div class="mt-4">
                <label class="form-label fw-bold d-block">
                    Amenities
                </label>
                <div class="row g-2">
                    <% const availableAmenities = [
                        { name: "Wifi", icon: "fa-wifi" },
                        { name: "Pool", icon: "fa-person-swimming" },
                        { name: "Free parking", icon: "fa-square-parking" },
                        { name: "Air conditioning", icon: "fa-snowflake" },
                        { name: "Kitchen", icon: "fa-kitchen-set" },
                        { name: "Dedicated workspace", icon: "fa-laptop" },
                        { name: "TV", icon: "fa-tv" },
                        { name: "EV charger", icon: "fa-charging-station" }
                    ]; %>

                    <% for (const item of availableAmenities) { %>
                        <% const isChecked = listing.amenities && listing.amenities.includes(item.name); %>
                        <div class="col-md-3 col-6">
                            <div class="form-check p-2 border rounded-3 bg-light">
                                <input
                                    class="form-check-input ms-0 me-2"
                                    type="checkbox"
                                    name="listing[amenities]"
                                    value="<%= item.name %>"
                                    id="edit-amenity-<%= item.name.replace(/\s+/g, '-') %>"
                                    <%= isChecked ? "checked" : "" %>
                                >
                                <label class="form-check-label small" for="edit-amenity-<%= item.name.replace(/\s+/g, '-') %>">
                                    <i class="fa-solid <%= item.icon %> me-1 text-secondary"></i><%= item.name %>
                                </label>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>


            <!-- Submit -->

            <button
                class="btn add-btn mt-4"
                type="submit"
            >
                Save Changes
            </button>

        </form>

    </div>

</div>

<script>
    // 1.1: Toggle photo for deletion on the edit form
    var pendingDeletes = {};

    function toggleDeletePhoto(btn, filename) {
        var wrapper = btn.closest('.existing-photo-item');
        var img     = wrapper.querySelector('img');
        var container = document.getElementById('deleteInputsContainer');
        var countEl   = document.getElementById('existingPhotoCount');

        if (pendingDeletes[filename]) {
            // Un-mark for deletion
            delete pendingDeletes[filename];
            var existing = container.querySelector('input[value="' + filename + '"]');
            if (existing) existing.remove();
            img.style.opacity = '1';
            wrapper.style.outline = '';
            btn.style.background  = '';
            btn.textContent = '\u00d7';
        } else {
            // Mark for deletion
            pendingDeletes[filename] = true;
            var input = document.createElement('input');
            input.type  = 'hidden';
            input.name  = 'deleteImages[]';
            input.value = filename;
            container.appendChild(input);
            img.style.opacity = '0.35';
            wrapper.style.outline = '2px solid #dc3545';
            btn.style.background  = '#555';
            btn.textContent = '\u21ba'; // ↺ undo icon
        }

        // Update counter
        var total   = document.querySelectorAll('.existing-photo-item').length;
        var deleted = Object.keys(pendingDeletes).length;
        if (countEl) countEl.textContent = (total - deleted);
    }
</script>