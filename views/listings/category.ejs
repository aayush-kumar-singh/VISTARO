<% layout("/layouts/boilerplate") %>

<div class="mt-4 mb-4">
    <h2 class="fw-bold fs-4">
        Stays in "<%= category %>"
    </h2>
</div>

<% if (alisting && alisting.length > 0) { %>

    <div class="listings-grid mb-5">

        <% for (const listing of alisting) { %>

            <div class="position-relative">

                <a href="/listings/<%= listing._id %>" class="card-link text-decoration-none">

                    <div class="listing-card">

                        <div class="listing-card-img-wrapper">
                            <img
                                class="card-img-top"
                                src="<%= listing.images?.[0]?.url || listing.image?.url %>"
                                alt="<%= listing.title %>"
                                loading="lazy"
                            >
                        </div>

                        <div class="listing-card-body">

                            <div class="listing-card-title-row">
                                <p class="listing-card-title">
                                    <%= listing.title %>
                                </p>
                            </div>

                            <p class="listing-card-price">
                                <span><%= typeof formatPrice !== 'undefined' ? formatPrice(listing.price) : '₹ ' + listing.price.toLocaleString("en-IN") %></span>
                                <span class="unit"> / night</span>
                            </p>

                        </div>

                    </div>

                </a>

            </div>

        <% } %>

    </div>

<% } else { %>

    <div class="alert alert-info mt-4 rounded-4 py-4 text-center">
        No listings found in the "<%= category %>" category.
    </div>

<% } %>
