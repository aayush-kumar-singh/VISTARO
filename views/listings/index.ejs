<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            margin-top: 1rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 4px 2px 8px 2px;
        }

        /* Scrollable strip for category items — shown on desktop (>=768px) */
        .filter-scroll {
            display: none;
            align-items: center;
            justify-content: space-between;
            overflow-x: auto;
            flex: 1;
            flex-wrap: nowrap;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }

        @media (min-width: 768px) {
            .filter-scroll {
                display: flex;
            }
        }

        .filter-scroll::-webkit-scrollbar {
            display: none;
        }

        /* Each filter item: icon stacked above label, all consistent */
        .filter {
            border: none;
            text-align: center;
            opacity: 0.7;
            cursor: pointer;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            gap: 0;
            transition: opacity 0.2s ease;
        }

        .filter:hover, .filter.active {
            opacity: 1;
        }

        /* Anchor inside filter inherits same column layout */
        .filter a {
            color: inherit;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0;
        }

        /* Fixed-size icon container so every item has the same icon height */
        .filter i {
            font-size: 1.2rem;
            width: 1.4rem;
            height: 1.4rem;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .filter p {
            font-size: 0.75rem;
            margin-top: 0.3rem;
            margin-bottom: 0;
            white-space: nowrap;
            font-weight: 500;
            line-height: 1;
        }

        /* Sort By dropdown — outside scroll container, vertically centered */
        #filters .dropdown {
            align-self: center;
            flex-shrink: 0;
        }

        .tax-info {
            display: none;
        }
    </style>


    <!-- Categories / Filters -->

    <div id="filters">

        <!-- Mobile-only button to trigger Category Side Panel -->
        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 d-md-none d-flex align-items-center gap-2"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#categorySidePanel"
                aria-controls="categorySidePanel"
                style="font-size: 0.85rem;">
            <i class="fa-solid fa-layer-group text-danger"></i>
            <span><%= selectedCategory || 'Categories' %></span>
            <i class="fa-solid fa-chevron-right ms-1" style="font-size: 0.65rem; opacity: 0.6;"></i>
        </button>

        <!-- Scrollable category strip for Desktop (>=768px) -->
        <div class="filter-scroll">

        <div class="filter">
            <a href="/listings">
                <i class="fa-solid fa-compass"></i>
                <p>All</p>
            </a>
        </div>


        <div class="filter">
            <a href="/category/Bed%20%26%20Breakfast">
                <i class="fa-solid fa-mug-hot"></i>
                <p>Bed & Breakfast</p>
            </a>
        </div>


        <div class="filter">
            <a href="/category/Farm">
                <i class="fa-solid fa-cow"></i>
                <p>Farm</p>
            </a>
        </div>


        <div class="filter">
            <a href="/category/OMG">
                <i class="fa-solid fa-satellite"></i>
                <p>OMG!</p>
            </a>
        </div>


        <div class="filter">
            <a href="/category/Arctic">
                <i class="fa-solid fa-snowflake"></i>
                <p>Arctic</p>
            </a>
        </div>


        <div class="filter">
            <a href="/category/Trending">
                <i class="fa-solid fa-fire"></i>
                <p>Trending</p>
            </a>
        </div>


        <div class="filter">
            <a href="/category/Lake">
                <i class="fa-solid fa-water"></i>
                <p>Lake</p>
            </a>
        </div>


        <div class="filter">
            <a href="/category/Beach">
                <i class="fa-solid fa-umbrella-beach"></i>
                <p>Beach</p>
            </a>
        </div>

        </div><!-- /.filter-scroll -->

        <!-- Sort dropdown — outside scroll container so it can overflow freely -->
        <div class="dropdown">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3 py-2" type="button"
                data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.85rem;">
                <i class="fa-solid fa-arrow-down-short-wide me-1"></i>
                <% if (sortOption==='price_asc' ) { %>
                    Price: Low to High
                    <% } else if (sortOption==='price_desc' ) { %>
                        Price: High to Low
                        <% } else if (sortOption==='newest' ) { %>
                            Newest First
                            <% } else { %>
                                Sort By
                                <% } %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3">
                <li>
                    <a class="dropdown-item <%= !sortOption ? 'active' : '' %>"
                        href="/listings?<%= selectedCategory ? 'category=' + encodeURIComponent(selectedCategory) + '&' : '' %><%= minPrice ? 'minPrice=' + minPrice + '&' : '' %><%= maxPrice ? 'maxPrice=' + maxPrice : '' %>">
                        Featured
                    </a>
                </li>
                <li>
                    <a class="dropdown-item <%= sortOption === 'price_asc' ? 'active' : '' %>"
                        href="/listings?<%= selectedCategory ? 'category=' + encodeURIComponent(selectedCategory) + '&' : '' %><%= minPrice ? 'minPrice=' + minPrice + '&' : '' %><%= maxPrice ? 'maxPrice=' + maxPrice + '&' : '' %>sort=price_asc">
                        Price: Low to High
                    </a>
                </li>
                <li>
                    <a class="dropdown-item <%= sortOption === 'price_desc' ? 'active' : '' %>"
                        href="/listings?<%= selectedCategory ? 'category=' + encodeURIComponent(selectedCategory) + '&' : '' %><%= minPrice ? 'minPrice=' + minPrice + '&' : '' %><%= maxPrice ? 'maxPrice=' + maxPrice + '&' : '' %>sort=price_desc">
                        Price: High to Low
                    </a>
                </li>
                <li>
                    <a class="dropdown-item <%= sortOption === 'newest' ? 'active' : '' %>"
                        href="/listings?<%= selectedCategory ? 'category=' + encodeURIComponent(selectedCategory) + '&' : '' %><%= minPrice ? 'minPrice=' + minPrice + '&' : '' %><%= maxPrice ? 'maxPrice=' + maxPrice + '&' : '' %>sort=newest">
                        Newest First
                    </a>
                </li>
            </ul>
        </div>

    </div>

    <!-- Mobile Category Side Panel (Offcanvas) -->
    <div class="offcanvas offcanvas-start rounded-end-4" tabindex="-1" id="categorySidePanel" aria-labelledby="categorySidePanelLabel" style="max-width: 300px;">
        <div class="offcanvas-header border-bottom py-3">
            <h5 class="offcanvas-title fw-bold fs-6 d-flex align-items-center gap-2 mb-0" id="categorySidePanelLabel">
                <i class="fa-solid fa-layer-group text-danger"></i>
                <span>Explore Categories</span>
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <div class="list-group list-group-flush">
                <a href="/listings" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-4 border-0 <%= !selectedCategory ? 'bg-danger-subtle text-danger fw-bold' : 'text-dark' %>">
                    <i class="fa-solid fa-compass fs-5" style="width: 26px; text-align: center;"></i>
                    <span>All</span>
                </a>
                <a href="/category/Bed%20%26%20Breakfast" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-4 border-0 <%= selectedCategory === 'Bed & Breakfast' ? 'bg-danger-subtle text-danger fw-bold' : 'text-dark' %>">
                    <i class="fa-solid fa-mug-hot fs-5" style="width: 26px; text-align: center;"></i>
                    <span>Bed & Breakfast</span>
                </a>
                <a href="/category/Farm" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-4 border-0 <%= selectedCategory === 'Farm' ? 'bg-danger-subtle text-danger fw-bold' : 'text-dark' %>">
                    <i class="fa-solid fa-cow fs-5" style="width: 26px; text-align: center;"></i>
                    <span>Farm</span>
                </a>
                <a href="/category/OMG" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-4 border-0 <%= selectedCategory === 'OMG' || selectedCategory === 'OMG!' ? 'bg-danger-subtle text-danger fw-bold' : 'text-dark' %>">
                    <i class="fa-solid fa-satellite fs-5" style="width: 26px; text-align: center;"></i>
                    <span>OMG!</span>
                </a>
                <a href="/category/Arctic" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-4 border-0 <%= selectedCategory === 'Arctic' ? 'bg-danger-subtle text-danger fw-bold' : 'text-dark' %>">
                    <i class="fa-solid fa-snowflake fs-5" style="width: 26px; text-align: center;"></i>
                    <span>Arctic</span>
                </a>
                <a href="/category/Trending" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-4 border-0 <%= selectedCategory === 'Trending' ? 'bg-danger-subtle text-danger fw-bold' : 'text-dark' %>">
                    <i class="fa-solid fa-fire fs-5" style="width: 26px; text-align: center;"></i>
                    <span>Trending</span>
                </a>
                <a href="/category/Lake" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-4 border-0 <%= selectedCategory === 'Lake' ? 'bg-danger-subtle text-danger fw-bold' : 'text-dark' %>">
                    <i class="fa-solid fa-water fs-5" style="width: 26px; text-align: center;"></i>
                    <span>Lake</span>
                </a>
                <a href="/category/Beach" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-4 border-0 <%= selectedCategory === 'Beach' ? 'bg-danger-subtle text-danger fw-bold' : 'text-dark' %>">
                    <i class="fa-solid fa-umbrella-beach fs-5" style="width: 26px; text-align: center;"></i>
                    <span>Beach</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Active Filter Badges Bar -->
    <% if (minPrice || maxPrice || selectedCategory || sortOption) { %>
        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <span class="text-muted small">Active Filters:</span>
            <% if (selectedCategory) { %>
                <span class="badge bg-secondary rounded-pill py-2 px-3">
                    Category: <%= selectedCategory %>
                        <a href="/listings<%= (minPrice || maxPrice || sortOption) ? '?' + (minPrice ? 'minPrice=' + minPrice + '&' : '') + (maxPrice ? 'maxPrice=' + maxPrice + '&' : '') + (sortOption ? 'sort=' + sortOption : '') : '' %>"
                            class="text-white text-decoration-none ms-1">&times;</a>
                </span>
                <% } %>
                    <% if (minPrice || maxPrice) { %>
                        <span class="badge bg-dark rounded-pill py-2 px-3">
                            Price: &#8377;<%= minPrice || '0' %> &ndash; &#8377;<%= maxPrice || 'Any' %>
                                    <a href="/listings<%= (selectedCategory || sortOption) ? '?' + (selectedCategory ? 'category=' + encodeURIComponent(selectedCategory) + '&' : '') + (sortOption ? 'sort=' + sortOption : '') : '' %>"
                                        class="text-white text-decoration-none ms-1">&times;</a>
                        </span>
                        <% } %>
                            <% if (sortOption) { %>
                                <span class="badge bg-info text-dark rounded-pill py-2 px-3">
                                    Sorted: <%= sortOption==='price_asc' ? 'Price Low-High' : (sortOption==='price_desc'
                                        ? 'Price High-Low' : 'Newest' ) %>
                                        <a href="/listings<%= (selectedCategory || minPrice || maxPrice) ? '?' + (selectedCategory ? 'category=' + encodeURIComponent(selectedCategory) + '&' : '') + (minPrice ? 'minPrice=' + minPrice + '&' : '') + (maxPrice ? 'maxPrice=' + maxPrice : '') : '' %>"
                                            class="text-dark text-decoration-none ms-1">&times;</a>
                                </span>
                                <% } %>
                                    <a href="/listings"
                                        class="btn btn-sm btn-link text-danger text-decoration-none small p-0">Clear
                                        all</a>
        </div>
        <% } %>

            <!-- Price Filter Modal -->
            <div class="modal fade" id="priceFilterModal" tabindex="-1" aria-labelledby="priceFilterModalLabel"
                aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0 shadow">
                        <div class="modal-header border-bottom-0 pb-0">
                            <h5 class="modal-title fw-bold" id="priceFilterModalLabel">Filter by Price</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form action="/listings" method="GET">
                            <% if (selectedCategory) { %>
                                <input type="hidden" name="category" value="<%= selectedCategory %>">
                                <% } %>
                                    <% if (sortOption) { %>
                                        <input type="hidden" name="sort" value="<%= sortOption %>">
                                        <% } %>
                                            <div class="modal-body">
                                                <p class="text-muted small mb-3">Nightly prices before taxes and fees
                                                </p>
                                                <div class="row g-3">
                                                    <div class="col-6">
                                                        <label for="minPrice"
                                                            class="form-label small fw-bold">MINIMUM</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text bg-white">&#8377;</span>
                                                            <input type="number" class="form-control" id="minPrice"
                                                                name="minPrice" placeholder="0" min="0"
                                                                value="<%= minPrice || '' %>">
                                                        </div>
                                                    </div>
                                                    <div class="col-6">
                                                        <label for="maxPrice"
                                                            class="form-label small fw-bold">MAXIMUM</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text bg-white">&#8377;</span>
                                                            <input type="number" class="form-control" id="maxPrice"
                                                                name="maxPrice" placeholder="Any" min="0"
                                                                value="<%= maxPrice || '' %>">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top-0 pt-0 d-flex justify-content-between">
                                                <a href="/listings<%= selectedCategory ? '?category=' + selectedCategory : '' %>"
                                                    class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                                    Reset
                                                </a>
                                                <button type="submit" class="btn btn-dark btn-sm rounded-pill px-4">
                                                    Apply Filter
                                                </button>
                                            </div>
                        </form>
                    </div>
                </div>
            </div>


            <!-- Recently Viewed Section (Logged-in users with history only) -->
            <% if (typeof recentlyViewed !== 'undefined' && recentlyViewed && recentlyViewed.length > 0) { %>
                <div class="recently-viewed-section mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h4 class="fw-bold fs-5 mb-0 text-dark">Recently viewed</h4>
                        <span class="text-muted small"><%= recentlyViewed.length %> <%= recentlyViewed.length === 1 ? 'place' : 'places' %></span>
                    </div>

                    <div class="d-flex gap-3 overflow-auto py-2 px-1 recent-scroll-container" style="scrollbar-width: none; -webkit-overflow-scrolling: touch;">
                        <% for (const rv of recentlyViewed) { %>
                            <% 
                                const inRvWishlist = currUser && currUser.wishlist && currUser.wishlist.some(w => w.toString() === rv._id.toString());
                                let rvRating = null;
                                if (rv.reviews && rv.reviews.length > 0) {
                                    const sum = rv.reviews.reduce((acc, r) => acc + (r.rating || 0), 0);
                                    const avg = sum / rv.reviews.length;
                                    if (!isNaN(avg) && avg > 0) {
                                        rvRating = Number(avg.toFixed(2));
                                    }
                                }
                                const isRvGuestFav = rvRating && rvRating >= 4.8;
                            %>
                            <div class="recent-card flex-shrink-0 position-relative" style="width: 175px;">
                                <!-- Wishlist Heart Button -->
                                <button type="button"
                                    class="btn btn-light rounded-circle position-absolute top-0 end-0 m-2 p-0 d-flex align-items-center justify-content-center shadow-sm"
                                    style="z-index: 5; width: 30px; height: 30px; border: 1px solid rgba(0,0,0,0.08); background-color: rgba(255, 255, 255, 0.9);"
                                    onclick="toggleWishlist('<%= rv._id %>', this, event)"
                                    title="<%= inRvWishlist ? 'Remove from wishlist' : 'Save to wishlist' %>">
                                    <i class="<%= inRvWishlist ? 'fa-solid text-danger' : 'fa-regular text-dark' %> fa-heart" style="font-size: 0.8rem;"></i>
                                </button>

                                <% if (isRvGuestFav) { %>
                                    <div class="position-absolute top-0 start-0 m-2 px-2 py-0 bg-white rounded-pill shadow-sm border border-light"
                                        style="z-index: 5; font-size: 0.65rem; font-weight: 700; color: #222; backdrop-filter: blur(6px); background-color: rgba(255, 255, 255, 0.92) !important;">
                                        Guest favourite
                                    </div>
                                <% } %>

                                <a href="/listings/<%= rv._id %>" class="text-decoration-none text-dark">
                                    <div class="card border-0 h-100 bg-transparent">
                                        <img src="<%= rv.images?.[0]?.url || rv.image?.url %>" 
                                             class="card-img-top rounded-4 shadow-sm" 
                                             alt="<%= rv.title %>" 
                                             style="height: 145px; width: 175px; object-fit: cover;">
                                        <div class="card-body p-1 pt-2">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <p class="card-text fw-semibold text-truncate mb-0 small text-dark" style="max-width: 120px;">
                                                    <%= rv.title %>
                                                </p>
                                                <% if (rvRating) { %>
                                                    <span class="small d-inline-flex align-items-center" style="font-size: 0.72rem;">
                                                        <i class="fa-solid fa-star me-1" style="font-size: 0.65rem;"></i>
                                                        <strong><%= rvRating %></strong>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="card-text text-muted mb-0" style="font-size: 0.8rem;">
                                                <strong class="text-dark"><%= typeof formatPrice !== 'undefined' ? formatPrice(rv.price) : 'â‚¹ ' + rv.price.toLocaleString("en-IN") %></strong> / night
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% } %>
                    </div>
                    <hr class="my-3 text-muted opacity-25">
                </div>
            <% } %>

                                    <!-- Listings (CSS Grid: Part 3 spec) -->
            <% if (allListing && allListing.length > 0) { %>
                <div class="listings-grid mb-5">

                    <% for (const listing of allListing) { %>

                        <% 
                            const inWishlist = currUser && currUser.wishlist && currUser.wishlist.some(w => w.toString() === listing._id.toString()); 
                            let avgRating = null;
                            let reviewCount = (listing.reviews && listing.reviews.length) || 0;
                            if (reviewCount > 0) {
                                const sum = listing.reviews.reduce((acc, r) => acc + (r.rating || 0), 0);
                                const avg = sum / reviewCount;
                                if (!isNaN(avg) && avg > 0) {
                                    avgRating = Number(avg.toFixed(2));
                                }
                            }
                            const isGuestFavourite = avgRating && avgRating >= 4.8;
                        %>

                            <div class="position-relative">

                                <!-- Guest Favourite Badge -->
                                <% if (isGuestFavourite) { %>
                                    <div class="guest-favourite-badge">
                                        Guest favourite
                                    </div>
                                <% } %>

                                <!-- Wishlist Heart Button (Min 40x40 touch area) -->
                                <button type="button"
                                    class="listing-wishlist-btn"
                                    onclick="toggleWishlist('<%= listing._id %>', this, event)"
                                    title="<%= inWishlist ? 'Remove from wishlist' : 'Save to wishlist' %>"
                                    aria-label="Save to wishlist">
                                    <i class="<%= inWishlist ? 'fa-solid text-danger' : 'fa-regular' %> fa-heart"></i>
                                </button>

                                <a href="/listings/<%= listing._id %>" class="card-link text-decoration-none">

                                    <div class="listing-card">

                                        <div class="listing-card-img-wrapper">
                                            <img class="card-img-top"
                                                src="<%= listing.images?.[0]?.url || listing.image?.url %>"
                                                alt="<%= listing.title %>"
                                                loading="lazy">
                                        </div>

                                        <div class="listing-card-body">

                                            <!-- Part 2: Title + Rating Row with ellipsis and non-wrapping star -->
                                            <div class="listing-card-title-row">
                                                <p class="listing-card-title">
                                                    <%= listing.title %>
                                                </p>
                                                <% if (avgRating) { %>
                                                    <div class="listing-card-rating">
                                                        <i class="fa-solid fa-star"></i>
                                                        <span><%= avgRating %></span>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <p class="listing-card-price">
                                                <span><%= typeof formatPrice !== 'undefined' ? formatPrice(listing.price) : '₹ ' + listing.price.toLocaleString("en-IN") %></span>
                                                <span class="unit"> / night</span>
                                            </p>

                                        </div>

                                    </div>

                                </a>

                            </div>

                    <% } %>

                </div>

                <!-- Pagination -->
                <% const buildPageUrl=(p)=> {
                    const params = [];
                    if (selectedCategory) params.push('category=' + encodeURIComponent(selectedCategory));
                    if (minPrice) params.push('minPrice=' + encodeURIComponent(minPrice));
                    if (maxPrice) params.push('maxPrice=' + encodeURIComponent(maxPrice));
                    if (sortOption) params.push('sort=' + encodeURIComponent(sortOption));
                    params.push('page=' + p);
                    return '/listings?' + params.join('&');
                    };
                    %>

                    <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                        <nav aria-label="Listings page navigation" class="mt-4 mb-5">
                            <ul class="pagination justify-content-center flex-wrap">
                                <!-- Previous Button -->
                                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link rounded-start-pill px-3"
                                        href="<%= buildPageUrl(currentPage - 1) %>" aria-label="Previous">
                                        <i class="fa-solid fa-chevron-left me-1"></i> Prev
                                    </a>
                                </li>

                                <!-- Page Numbers -->
                                <% for (let i=1; i <=totalPages; i++) { %>
                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                        <a class="page-link" href="<%= buildPageUrl(i) %>">
                                            <%= i %>
                                        </a>
                                    </li>
                                    <% } %>

                                        <!-- Next Button -->
                                        <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                            <a class="page-link rounded-end-pill px-3"
                                                href="<%= buildPageUrl(currentPage + 1) %>" aria-label="Next">
                                                Next <i class="fa-solid fa-chevron-right ms-1"></i>
                                            </a>
                                        </li>
                            </ul>
                            <p class="text-center text-muted small">Showing page <%= currentPage %> of <%= totalPages %>
                                        (<%= totalListings %> properties total)</p>
                        </nav>
                        <% } %>

                            <% } else { %>
                                <div class="text-center py-5 border rounded-4 bg-light my-4">
                                    <i class="fa-solid fa-filter-circle-xmark fs-1 text-muted mb-3 d-block"></i>
                                    <h4>No listings match your filters</h4>
                                    <p class="text-muted">Try adjusting or clearing your price range and category
                                        filters to find available properties.</p>
                                    <a href="/listings" class="btn btn-dark rounded-pill px-4 mt-2">
                                        Reset All Filters
                                    </a>
                                </div>
                                <% } %>


                                    <script>
                                        const getSwitch =
                                            document.getElementById("flexSwitchCheckDefault");

                                        if (getSwitch) {
                                            getSwitch.addEventListener("change", () => {
                                                const elements =
                                                    document.getElementsByClassName("tax-info");

                                                for (const info of elements) {
                                                    if (getSwitch.checked) {
                                                        info.style.display = "inline";
                                                    } else {
                                                        info.style.display = "none";
                                                    }
                                                }
                                            });
                                        }

                                        async function toggleWishlist(listingId, btn, event) {
                                            if (event) {
                                                event.preventDefault();
                                                event.stopPropagation();
                                            }
                                            if (!<%= currUser ? 'true' : 'false' %>) {
                                                window.location.href = '/login';
                                                return;
                                            }
                                            try {
                                                const res = await fetch(`/listings/${listingId}/toggle`, {
                                                    method: 'POST',
                                                    headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
                                                });
                                                if (res.ok) {
                                                    const data = await res.json();
                                                    const icon = btn.querySelector('i');
                                                    if (data.inWishlist) {
                                                        icon.className = 'fa-solid fa-heart text-danger fs-6';
                                                        btn.title = 'Remove from wishlist';
                                                    } else {
                                                        icon.className = 'fa-regular fa-heart text-dark fs-6';
                                                        btn.title = 'Save to wishlist';
                                                    }
                                                } else if (res.status === 401 || res.redirected) {
                                                    window.location.href = '/login';
                                                }
                                            } catch (e) {
                                                console.error('Wishlist toggle failed:', e);
                                            }
                                        }
                                    </script>



