<% layout("/layouts/boilerplate") %>

<script>
    const listing = <%- JSON.stringify(listing).replace(/</g, '\\u003c') %>;
</script>


<div class="row mt-3">

    <!-- Listing title & Wishlist action -->
    <div class="col-12 col-lg-10 offset-lg-1">
        <div class="d-flex justify-content-between align-items-center py-2">
            <h2 class="fw-bold mb-0"><%= listing.title %></h2>
            <% const inWishlist = currUser && currUser.wishlist && currUser.wishlist.some(w => w.toString() === listing._id.toString()); %>
            <button
                type="button"
                class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 d-flex align-items-center gap-2"
                id="showWishlistBtn"
                onclick="toggleShowWishlist('<%= listing._id %>')"
            >
                <i class="<%= inWishlist ? 'fa-solid' : 'fa-regular' %> fa-heart" id="showHeartIcon"></i>
                <span id="showWishlistText"><%= inWishlist ? 'Saved' : 'Save' %></span>
            </button>
        </div>
    </div>


    <!-- Main content: 2-column on desktop -->
    <div class="col-12 col-lg-10 offset-lg-1">

        <div class="row">

            <!-- Left: Listing details -->
            <div class="col-md-7 col-12">

                <div class="card listing-card">

                    <% if (listing.images && listing.images.length > 1) { %>
                        <!-- Photo Gallery Carousel -->
                        <div id="listingCarousel" class="carousel slide carousel-fade mb-2 rounded-4 overflow-hidden shadow-sm" data-bs-ride="carousel">
                            <div class="carousel-indicators">
                                <% listing.images.forEach((img, idx) => { %>
                                    <button type="button" data-bs-target="#listingCarousel" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>" aria-current="<%= idx === 0 ? 'true' : 'false' %>" aria-label="Slide <%= idx + 1 %>"></button>
                                <% }); %>
                            </div>
                            <div class="carousel-inner">
                                <% listing.images.forEach((img, idx) => { %>
                                    <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                                        <img src="<%= img.url %>" class="d-block w-100 show-img" alt="<%= listing.title %> photo <%= idx + 1 %>">
                                    </div>
                                <% }); %>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                    <% } else { %>
                        <img
                            src="<%= listing.images?.[0]?.url || listing.image?.url %>"
                            class="card-img-top show-img rounded-4"
                            alt="listing_image"
                        >
                    <% } %>

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <p class="card-text text-muted mb-0">
                                Hosted by <b>@<%= listing.owner ? listing.owner.username : "host" %></b>
                            </p>
                            <% if (currUser && listing.owner && !listing.owner._id.equals(currUser._id)) { %>
                                <form method="POST" action="/inbox/start/<%= listing._id %>" class="d-inline">
                                    <button type="submit" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                        <i class="fa-regular fa-comment-dots me-1 text-danger"></i>Contact Host
                                    </button>
                                </form>
                            <% } %>
                        </div>

                        <p class="card-text">
                            <%= listing.description %>
                        </p>

                        <p class="card-text text-muted mb-2">
                            <i class="fa-solid fa-user-group text-secondary me-1"></i>
                            Accommodates up to <b><%= listing.maxGuests || 4 %> guests</b>
                        </p>

                        <p class="card-text">
                            <i class="fa-solid fa-location-dot text-danger"></i>
                            <%= listing.location %>, <%= listing.country %>
                        </p>

                        <% if (listing.category) { %>
                            <p class="card-text">
                                <span class="badge bg-secondary">
                                    <%= listing.category %>
                                </span>
                            </p>
                        <% } %>

                        <!-- Cancellation Policy Information -->
                        <div class="my-3 p-3 bg-light rounded-4 border">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-shield-halved text-success"></i>
                                <strong><%= (listing.cancellationPolicy || 'flexible').charAt(0).toUpperCase() + (listing.cancellationPolicy || 'flexible').slice(1) %> Cancellation Policy</strong>
                            </div>
                            <p class="small text-muted mb-0">
                                <% if (listing.cancellationPolicy === 'strict') { %>
                                    50% refund up to 7 days before check-in. Non-refundable after that.
                                <% } else if (listing.cancellationPolicy === 'moderate') { %>
                                    Full refund up to 5 days before check-in.
                                <% } else { %>
                                    Full refund up to 48 hours before check-in.
                                <% } %>
                            </p>
                        </div>

                        <!-- Amenities -->
                        <% if (listing.amenities && listing.amenities.length > 0) { %>
                            <div class="my-3">
                                <h5 class="fw-bold mb-2">What this place offers</h5>
                                <div class="row g-2">
                                    <%
                                    const amenityIcons = {
                                        "Wifi": "fa-wifi",
                                        "Pool": "fa-person-swimming",
                                        "Free parking": "fa-square-parking",
                                        "Air conditioning": "fa-snowflake",
                                        "Kitchen": "fa-kitchen-set",
                                        "Dedicated workspace": "fa-laptop",
                                        "TV": "fa-tv",
                                        "EV charger": "fa-charging-station"
                                    };
                                    %>
                                    <% for (const a of listing.amenities) { %>
                                        <div class="col-6 mb-1">
                                            <i class="fa-solid <%= amenityIcons[a] || 'fa-check' %> text-muted me-2"></i>
                                            <span><%= a %></span>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>

                        <!-- Visual Availability Calendar Section -->
                        <div class="my-4 p-3 bg-light rounded-4 border" id="availability-calendar-section">
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <div>
                                    <h5 class="fw-bold mb-1">
                                        <i class="fa-regular fa-calendar-check text-danger me-2"></i>Availability Calendar
                                    </h5>
                                    <p class="small text-muted mb-0">Check open dates & booked windows before reserving</p>
                                </div>
                                <div class="d-flex align-items-center gap-3 small">
                                    <span class="d-flex align-items-center gap-1">
                                        <span class="d-inline-block rounded-circle bg-success" style="width: 10px; height: 10px;"></span>
                                        Available
                                    </span>
                                    <span class="d-flex align-items-center gap-1">
                                        <span class="d-inline-block rounded-circle bg-secondary" style="width: 10px; height: 10px;"></span>
                                        Booked
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-center overflow-auto py-2">
                                <div id="inlineAvailabilityCalendar"></div>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Owner controls -->
                <% if (
                    currUser &&
                    listing.owner &&
                    listing.owner._id.equals(currUser._id)
                ) { %>

                    <div class="btns mb-4">

                        <!-- Edit -->
                        <a href="/listings/<%= listing._id %>/edit">
                            <button class="btn add-btn btn-dark">
                                Edit
                            </button>
                        </a>

                        <!-- Delete -->
                        <form
                            method="post"
                            action="/listings/<%= listing._id %>?_method=DELETE"
                        >
                            <button class="btn btn-dark">
                                Delete
                            </button>
                        </form>

                    </div>

                <% } %>

            </div>


            <!-- Right: Reservation Widget -->
            <div class="col-md-5 col-12">

                <div class="card shadow-sm p-3 mb-4 rounded-4 border">

                    <div class="d-flex align-items-baseline gap-1 mb-3">
                        <span class="fs-4 fw-semibold"><%= typeof formatPrice !== 'undefined' ? formatPrice(listing.price) : '₹ ' + listing.price.toLocaleString("en-IN") %></span>
                        <span class="text-muted">/ night</span>
                    </div>

                    <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>

                        <div class="alert alert-secondary text-center my-2">
                            <i class="fa-solid fa-house-user fs-4 mb-2 d-block"></i>
                            <strong>Your Listing</strong>
                            <p class="small text-muted mb-0">You cannot make reservations on your own property.</p>
                        </div>

                    <% } else { %>

                        <form
                            action="/listings/<%= listing._id %>/bookings"
                            method="POST"
                            class="needs-validation"
                            novalidate
                            id="bookingForm"
                        >

                            <div class="mb-2">
                                <label for="dateRange" class="form-label small fw-bold">
                                    DATES (CHECK-IN &ndash; CHECKOUT)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="fa-regular fa-calendar-days text-danger"></i>
                                    </span>
                                    <input
                                        type="text"
                                        class="form-control bg-white"
                                        id="dateRange"
                                        placeholder="Select dates"
                                        readonly
                                        required
                                    >
                                </div>
                                <input type="hidden" id="checkIn" name="booking[checkIn]" required>
                                <input type="hidden" id="checkOut" name="booking[checkOut]" required>
                            </div>

                            <div class="mb-3">
                                <label for="guests" class="form-label small fw-bold">
                                    GUESTS
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white">
                                        <i class="fa-solid fa-user-group text-muted"></i>
                                    </span>
                                    <input
                                        type="number"
                                        class="form-control"
                                        id="guests"
                                        name="booking[guests]"
                                        value="1"
                                        min="1"
                                        max="<%= listing.maxGuests || 4 %>"
                                        required
                                    >
                                </div>
                                <small class="text-muted">Maximum capacity: <%= listing.maxGuests || 4 %> guest(s)</small>
                            </div>

                            <!-- Live conflict alert -->
                            <div id="conflictAlert" class="alert alert-danger d-none small py-2">
                                <i class="fa-solid fa-circle-exclamation me-1"></i>
                                Selected dates are already booked.
                            </div>

                            <button
                                type="submit"
                                class="btn add-btn btn-danger w-100 py-2 fw-bold"
                                id="reserveBtn"
                            >
                                Reserve
                            </button>

                            <p class="text-center text-muted small mt-2 mb-3">
                                You won't be charged yet
                            </p>

                            <!-- Dynamic Price Breakdown -->
                            <div id="priceCalculation" class="d-none border-top pt-3">

                                <div class="d-flex justify-content-between mb-2 small">
                                    <span id="priceNightsCalc">&#8377; <%= listing.price %> × 0 nights</span>
                                    <span id="basePriceTotal">&#8377; 0</span>
                                </div>

                                <div class="d-flex justify-content-between mb-2 text-muted small">
                                    <span>GST (18%)</span>
                                    <span id="gstAmount">&#8377; 0</span>
                                </div>

                                <hr>

                                <div class="d-flex justify-content-between fw-bold fs-6">
                                    <span>Total (incl. taxes)</span>
                                    <span id="grandTotal">&#8377; 0</span>
                                </div>

                            </div>

                        </form>

                    <% } %>

                </div>

            </div>

        </div>

    </div>


    <!-- Reviews section -->
    <div class="col-12 col-lg-10 offset-lg-1 mt-3 mb-3">

        <hr>


        <!-- Review section -->
        <% const userHasReviewed = currUser && listing.reviews && listing.reviews.some(r => r.author && r.author._id.equals(currUser._id)); %>
        <% const isListingOwner = currUser && listing.owner && listing.owner._id.equals(currUser._id); %>

        <% if (currUser) { %>

            <% if (isListingOwner) { %>

                <!-- Hosts cannot review their own listing -->

            <% } else if (userHasReviewed) { %>

                <div class="alert alert-light border rounded-4 p-3 mb-4 d-flex align-items-center">
                    <i class="fa-solid fa-circle-check text-success fs-4 me-3"></i>
                    <div>
                        <strong class="d-block">Review Submitted</strong>
                        <span class="text-muted small">You have already shared your feedback for this property.</span>
                    </div>
                </div>

            <% } else { %>

                <h3>Leave a Review</h3>

                <div class="mt-3 mb-3">

                    <form
                        action="/listings/<%= listing._id %>/reviews"
                        method="POST"
                        novalidate
                        class="needs-validation"
                    >

                    <label
                        for="rating"
                        class="form-label"
                    >
                        Rating
                    </label>


                    <fieldset class="starability-basic">

                        <input
                            type="radio"
                            id="no-rate"
                            class="input-no-rate"
                            name="review[rating]"
                            value="0"
                            checked
                            aria-label="No rating."
                        />

                        <input
                            type="radio"
                            id="first-rate1"
                            name="review[rating]"
                            value="1"
                        />

                        <label
                            for="first-rate1"
                            title="Terrible"
                        >
                            1 star
                        </label>


                        <input
                            type="radio"
                            id="first-rate2"
                            name="review[rating]"
                            value="2"
                        />

                        <label
                            for="first-rate2"
                            title="Not good"
                        >
                            2 stars
                        </label>


                        <input
                            type="radio"
                            id="first-rate3"
                            name="review[rating]"
                            value="3"
                        />

                        <label
                            for="first-rate3"
                            title="Average"
                        >
                            3 stars
                        </label>


                        <input
                            type="radio"
                            id="first-rate4"
                            name="review[rating]"
                            value="4"
                        />

                        <label
                            for="first-rate4"
                            title="Very good"
                        >
                            4 stars
                        </label>


                        <input
                            type="radio"
                            id="first-rate5"
                            name="review[rating]"
                            value="5"
                        />

                        <label
                            for="first-rate5"
                            title="Amazing"
                        >
                            5 stars
                        </label>

                    </fieldset>

            </div>


            <div class="mt-3 mb-3">

                <label
                    for="comment"
                    class="form-label"
                >
                    Comment
                </label>

                <textarea
                    id="comment"
                    rows="10"
                    cols="30"
                    class="form-control"
                    name="review[comment]"
                    required
                ></textarea>

                <div class="invalid-feedback">
                    Please add some comment
                </div>

            </div>


            <button class="btn btn-outline-danger mt-3">
                Submit
            </button>

            </form>

            <hr>

        <% } %>
        <% } %>


        <!-- Reviews heading -->
        <% if (listing.reviews && listing.reviews.length > 0) { %>

            <h4>All Reviews</h4>

        <% } %>


        <!-- Reviews -->
        <div class="row">

            <% for (const review of listing.reviews || []) { %>

                <div class="card col-12 col-md-5 mb-3 ms-md-3">

                    <div class="card-body">

                        <% if (review.author) { %>

                            <h5 class="card-title">
                                @<%= review.author.username %>
                            </h5>

                        <% } %>


                        <p
                            class="starability-result card-text"
                            data-rating="<%= review.rating %>"
                        ></p>


                        <p class="card-text mb-2">
                            <%= review.comment %>
                        </p>

                        <% if (review.ownerReply && review.ownerReply.comment) { %>
                            <div class="bg-light p-2 rounded-3 mt-2 border-start border-3 border-danger">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small text-dark"><i class="fa-solid fa-reply me-1 text-danger"></i>Host Response</strong>
                                    <div class="d-flex align-items-center gap-2">
                                        <small class="text-muted" style="font-size: 0.75rem;"><%= new Date(review.ownerReply.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %></small>
                                        <% if (isListingOwner) { %>
                                            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>/reply?_method=DELETE" class="d-inline" onsubmit="return confirm('Remove your response?');">
                                                <button type="submit" class="btn btn-link p-0 text-danger small text-decoration-none" title="Delete Response" style="font-size: 0.75rem;">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                                <p class="small text-muted mb-0"><%= review.ownerReply.comment %></p>
                            </div>
                        <% } else if (isListingOwner) { %>
                            <!-- Host Reply Accordion / Form -->
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" type="button" data-bs-toggle="collapse" data-bs-target="#replyForm-<%= review._id %>" aria-expanded="false" style="font-size: 0.8rem;">
                                    <i class="fa-solid fa-reply me-1"></i>Reply to Guest
                                </button>
                                <div class="collapse mt-2" id="replyForm-<%= review._id %>">
                                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>/reply" class="bg-light p-2 rounded-3 border">
                                        <label for="replyComment-<%= review._id %>" class="form-label small fw-bold mb-1">Public Response</label>
                                        <textarea id="replyComment-<%= review._id %>" name="reply[comment]" class="form-control form-control-sm mb-2" rows="2" placeholder="Write a response to this guest review..." required></textarea>
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-sm btn-light" data-bs-toggle="collapse" data-bs-target="#replyForm-<%= review._id %>">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-dark">Post Reply</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        <% } %>

                    </div>


                    <!-- Review delete (Author only) -->
                    <% if (
                        currUser &&
                        review.author &&
                        review.author._id.equals(currUser._id)
                    ) { %>

                        <form
                            method="POST"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                        >

                            <button
                                class="btn btn-dark mb-3 mt-3"
                            >
                                Delete
                            </button>

                        </form>

                    <% } %>

                </div>

            <% } %>

        </div>

    </div>


    <!-- Map -->
    <div class="col-12 col-lg-10 offset-lg-1 mb-3">

        <h3>Where You will be</h3>

        <div id="map"></div>

    </div>

<!-- Booking widget client script -->
<script>
    const activeBookings = <%- JSON.stringify(activeBookings || []) %>;
    const nightlyPrice = <%= listing.price %>; // always in INR (base)

    // Active currency injected from server session
    const currencyCode  = "<%= currCurrency || 'INR' %>";
    const currencyRate  = <%= (availableCurrencies && availableCurrencies[currCurrency]) ? availableCurrencies[currCurrency].rate : 1 %>;
    const currencyLocale = "<%= (availableCurrencies && availableCurrencies[currCurrency]) ? availableCurrencies[currCurrency].locale : 'en-IN' %>";

    function formatAmountInINR(amountINR) {
        const converted = amountINR * currencyRate;
        try {
            return new Intl.NumberFormat(currencyLocale, {
                style: "currency",
                currency: currencyCode,
                maximumFractionDigits: 0,
            }).format(converted);
        } catch (e) {
            return currencyCode + " " + Math.round(converted).toLocaleString();
        }
    }

    const checkInInput = document.getElementById("checkIn");
    const checkOutInput = document.getElementById("checkOut");
    const conflictAlert = document.getElementById("conflictAlert");
    const reserveBtn = document.getElementById("reserveBtn");
    const priceCalculation = document.getElementById("priceCalculation");
    const priceNightsCalc = document.getElementById("priceNightsCalc");
    const basePriceTotal = document.getElementById("basePriceTotal");
    const gstAmount = document.getElementById("gstAmount");
    const grandTotal = document.getElementById("grandTotal");

    function updateBookingDetails() {
        const checkInVal = checkInInput ? checkInInput.value : "";
        const checkOutVal = checkOutInput ? checkOutInput.value : "";

        if (!checkInVal || !checkOutVal) {
            if (priceCalculation) priceCalculation.classList.add("d-none");
            if (conflictAlert) conflictAlert.classList.add("d-none");
            if (reserveBtn) reserveBtn.disabled = false;
            return;
        }

        const start = new Date(checkInVal);
        const end = new Date(checkOutVal);

        if (end <= start) {
            if (priceCalculation) priceCalculation.classList.add("d-none");
            return;
        }

        // Check conflict with active bookings
        const hasConflict = activeBookings.some((b) => {
            const bStart = new Date(b.checkIn);
            const bEnd = new Date(b.checkOut);
            return start < bEnd && end > bStart;
        });

        if (hasConflict) {
            if (conflictAlert) conflictAlert.classList.remove("d-none");
            if (reserveBtn) reserveBtn.disabled = true;
            if (priceCalculation) priceCalculation.classList.add("d-none");
            return;
        } else {
            if (conflictAlert) conflictAlert.classList.add("d-none");
            if (reserveBtn) reserveBtn.disabled = false;
        }

        // Calculate nights and prices
        const diffDays = Math.ceil(Math.abs(end - start) / (1000 * 60 * 60 * 24));
        const base = diffDays * nightlyPrice;
        const gst = Math.round(base * 0.18);
        const total = base + gst;

        if (priceNightsCalc) priceNightsCalc.innerText = formatAmountInINR(nightlyPrice) + " × " + diffDays + " night(s)";
        if (basePriceTotal) basePriceTotal.innerText = formatAmountInINR(base);
        if (gstAmount) gstAmount.innerText = formatAmountInINR(gst);
        if (grandTotal) grandTotal.innerText = formatAmountInINR(total);

        if (priceCalculation) priceCalculation.classList.remove("d-none");
    }

    // Prepare disabled dates for Flatpickr calendar
    const disabledDates = activeBookings.map((b) => ({
        from: new Date(b.checkIn).toISOString().split("T")[0],
        to: new Date(new Date(b.checkOut).getTime() - 86400000).toISOString().split("T")[0],
    }));

    let dateRangePicker = null;
    let inlinePicker = null;

    if (typeof flatpickr !== "undefined") {
        // 1. Interactive Reservation Range Picker
        if (document.getElementById("dateRange")) {
            dateRangePicker = flatpickr("#dateRange", {
                mode: "range",
                minDate: "today",
                dateFormat: "Y-m-d",
                disable: disabledDates,
                showMonths: 1,
                onChange: function (selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        const start = selectedDates[0];
                        const end = selectedDates[1];

                        const startStr = instance.formatDate(start, "Y-m-d");
                        const endStr = instance.formatDate(end, "Y-m-d");

                        if (checkInInput) checkInInput.value = startStr;
                        if (checkOutInput) checkOutInput.value = endStr;

                        if (inlinePicker) {
                            inlinePicker.setDate([start, end], false);
                        }

                        updateBookingDetails();
                    } else {
                        if (checkInInput) checkInInput.value = "";
                        if (checkOutInput) checkOutInput.value = "";
                        if (priceCalculation) priceCalculation.classList.add("d-none");
                    }
                },
            });
        }

        // 2. Visual Inline Availability Calendar
        if (document.getElementById("inlineAvailabilityCalendar")) {
            inlinePicker = flatpickr("#inlineAvailabilityCalendar", {
                inline: true,
                mode: "range",
                minDate: "today",
                dateFormat: "Y-m-d",
                disable: disabledDates,
                showMonths: window.innerWidth > 768 ? 2 : 1,
                onChange: function (selectedDates, dateStr, instance) {
                    if (selectedDates.length === 2) {
                        const start = selectedDates[0];
                        const end = selectedDates[1];

                        const startStr = instance.formatDate(start, "Y-m-d");
                        const endStr = instance.formatDate(end, "Y-m-d");

                        if (checkInInput) checkInInput.value = startStr;
                        if (checkOutInput) checkOutInput.value = endStr;

                        if (dateRangePicker) {
                            dateRangePicker.setDate([start, end], false);
                        }

                        updateBookingDetails();
                    }
                },
            });
        }
    }

    async function toggleShowWishlist(listingId) {
        // Redirect to login if not authenticated
        if (!<%= currUser ? 'true' : 'false' %>) {
            window.location.href = '/login';
            return;
        }
        try {
            const res = await fetch(`/listings/${listingId}/toggle`, {
                method: 'POST',
                headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (res.ok) {
                const data = await res.json();
                const icon = document.getElementById("showHeartIcon");
                const text = document.getElementById("showWishlistText");
                if (icon && text) {
                    if (data.inWishlist) {
                        icon.className = 'fa-solid fa-heart';
                        text.innerText = 'Saved';
                    } else {
                        icon.className = 'fa-regular fa-heart';
                        text.innerText = 'Save';
                    }
                }
            } else if (res.status === 401 || res.redirected) {
                window.location.href = '/login';
            }
        } catch (e) {
            console.error('Failed to toggle wishlist:', e);
        }
    }
</script>

