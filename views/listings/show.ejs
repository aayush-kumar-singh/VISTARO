<% if (typeof similarListings !== 'undefined' && similarListings && similarListings.length > 0) { %>
<!-- 2.2: Similar Stays -->
<div class="row mt-2 mb-5">
    <div class="col-12 col-lg-10 offset-lg-1">
        <hr>
        <h4 class="fw-bold mb-3">
            <i class="fa-solid fa-layer-group text-danger me-2"></i>Similar stays
            <% if (listing.category) { %><span class="text-muted fw-normal fs-6 ms-1">in <%= listing.category %></span><% } %>
        </h4>
        <div class="listings-grid mb-2">
            <% for (const sim of similarListings) { %>
                <%
                    let simRating = null;
                    if (sim.reviews && sim.reviews.length > 0) {
                        const simSum = sim.reviews.reduce((a, r) => a + (r.rating || 0), 0);
                        const simAvg = simSum / sim.reviews.length;
                        if (!isNaN(simAvg) && simAvg > 0) simRating = Number(simAvg.toFixed(1));
                    }
                %>
                <a href="/listings/<%= sim._id %>" class="card-link text-decoration-none">
                    <div class="listing-card">
                        <div class="listing-card-img-wrapper">
                            <img class="card-img-top"
                                src="<%= sim.images?.[0]?.url || sim.image?.url %>"
                                alt="<%= sim.title %>" loading="lazy" style="cursor:default;">
                        </div>
                        <div class="listing-card-body">
                            <div class="listing-card-title-row">
                                <p class="listing-card-title"><%= sim.title %></p>
                                <% if (simRating) { %>
                                    <div class="listing-card-rating">
                                        <i class="fa-solid fa-star"></i>
                                        <span><%= simRating %></span>
                                    </div>
                                <% } %>
                            </div>
                            <p class="text-muted mb-0" style="font-size:0.78rem;"><%= sim.location %>, <%= sim.country %></p>
                            <p class="listing-card-price mt-1">
                                <span><%= typeof formatPrice !== 'undefined' ? formatPrice(sim.price) : '&#8377;' + sim.price.toLocaleString('en-IN') %></span>
                                <span class="unit"> / night</span>
                            </p>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>
    </div>
</div>
<% } %>

<!-- 2.2: Lightbox overlay -->
<div id="vistaro-lightbox" role="dialog" aria-modal="true" aria-label="Photo lightbox">
    <button class="lb-close" onclick="closeLightbox()" aria-label="Close lightbox">&times;</button>
    <button class="lb-nav lb-prev" onclick="lightboxNav(-1)" aria-label="Previous photo"><i class="fa-solid fa-chevron-left"></i></button>
    <img id="lb-img" src="" alt="Listing photo">
    <button class="lb-nav lb-next" onclick="lightboxNav(1)" aria-label="Next photo"><i class="fa-solid fa-chevron-right"></i></button>
    <p class="lb-counter" id="lb-counter"></p>
</div>

<script>
// 2.2: Lightbox
var lbImages = [];
var lbIndex = 0;

(function setupLightbox() {
    // Gather all listing images
    var imgEls = document.querySelectorAll('.carousel-item img, .show-img');
    imgEls.forEach(function(img, i) {
        lbImages.push(img.src);
        img.addEventListener('click', function() { openLightbox(i); });
    });
    // Close on backdrop click
    document.getElementById('vistaro-lightbox').addEventListener('click', function(e) {
        if (e.target === this) closeLightbox();
    });
    // Keyboard nav
    document.addEventListener('keydown', function(e) {
        var lb = document.getElementById('vistaro-lightbox');
        if (!lb.classList.contains('active')) return;
        if (e.key === 'ArrowRight') lightboxNav(1);
        else if (e.key === 'ArrowLeft') lightboxNav(-1);
        else if (e.key === 'Escape') closeLightbox();
    });
})();

function openLightbox(idx) {
    if (!lbImages.length) return;
    lbIndex = idx;
    document.getElementById('lb-img').src = lbImages[lbIndex];
    document.getElementById('lb-counter').textContent = (lbIndex + 1) + ' / ' + lbImages.length;
    document.getElementById('vistaro-lightbox').classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closeLightbox() {
    document.getElementById('vistaro-lightbox').classList.remove('active');
    document.body.style.overflow = '';
}

function lightboxNav(dir) {
    if (!lbImages.length) return;
    lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
    document.getElementById('lb-img').src = lbImages[lbIndex];
    document.getElementById('lb-counter').textContent = (lbIndex + 1) + ' / ' + lbImages.length;
}

// 2.2: Share button (Web Share API with copy-link fallback)
function shareListingPage(title) {
    var url = window.location.href;
    if (navigator.share) {
        navigator.share({ title: title + ' on Vistaro', url: url })
            .catch(function() {});
    } else {
        navigator.clipboard.writeText(url).then(function() {
            var btn = document.getElementById('shareBtn');
            if (btn) {
                var orig = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
                setTimeout(function() { btn.innerHTML = orig; }, 2000);
            }
        }).catch(function() {
            prompt('Copy this link:', url);
        });
    }
}

// 2.4: Booking confirm spinner
function handleConfirmReserve(btn) {
    var form = document.getElementById('bookingForm');
    if (form) {
        btn.classList.add('btn-loading');
        btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Processing...';
        form.submit();
    }
}
</script>