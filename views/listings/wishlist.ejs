<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fa-solid fa-heart text-danger me-2"></i>My Wishlist
            </h2>
            <p class="text-muted mb-0">
                <%= wishlist ? wishlist.length : 0 %> saved properties
            </p>
        </div>
        <a href="/listings" class="btn btn-outline-dark btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>Explore All Listings
        </a>
    </div>

        <% if (wishlist && wishlist.length > 0) { %>

        <div class="listings-grid mb-5">

            <% for (const listing of wishlist) { %>

                <div class="position-relative" id="wishlist-card-<%= listing._id %>">

                    <!-- Heart toggle button -->
                    <button
                        type="button"
                        class="listing-wishlist-btn"
                        onclick="toggleWishlist('<%= listing._id %>', event)"
                        title="Remove from wishlist"
                        aria-label="Remove from wishlist"
                    >
                        <i class="fa-solid fa-heart text-danger" id="heart-icon-<%= listing._id %>"></i>
                    </button>

                    <a href="/listings/<%= listing._id %>" class="card-link text-decoration-none text-dark">

                        <div class="listing-card">

                            <div class="listing-card-img-wrapper">
                                <img
                                    src="<%= listing.images?.[0]?.url || listing.image?.url %>"
                                    class="card-img-top"
                                    alt="<%= listing.title %>"
                                    loading="lazy"
                                >
                            </div>

                            <div class="listing-card-body">

                                <div class="listing-card-title-row">
                                    <p class="listing-card-title">
                                        <%= listing.title %>
                                    </p>
                                </div>

                                <p class="card-text text-muted small mb-1">
                                    <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                                </p>

                                <p class="listing-card-price">
                                    <span><%= typeof formatPrice !== 'undefined' ? formatPrice(listing.price) : '₹ ' + listing.price.toLocaleString("en-IN") %></span>
                                    <span class="unit"> / night</span>
                                </p>

                            </div>

                        </div>

                    </a>

                </div>

            <% } %>

        </div>

    <% } else { %>

        <div class="text-center py-5 border rounded-4 bg-light">
            <i class="fa-regular fa-heart fs-1 text-muted mb-3 d-block"></i>
            <h4>Your wishlist is empty</h4>
            <p class="text-muted">Explore our curated stays and tap the heart icon on any listing to save your favorites.</p>
            <a href="/listings" class="btn add-btn btn-danger px-4 mt-2">
                Discover Places
            </a>
        </div>

    <% } %>

</div>

<script>
async function toggleWishlist(listingId, event) {
    if (event) event.preventDefault();
    try {
        const res = await fetch(`/listings/${listingId}/toggle`, {
            method: 'POST',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (res.ok) {
            const data = await res.json();
            const card = document.getElementById(`wishlist-card-${listingId}`);
            if (card && !data.inWishlist) {
                card.remove();
            }
        } else if (res.status === 401 || res.redirected) {
            window.location.href = '/login';
        }
    } catch (e) {
        console.error('Failed to toggle wishlist:', e);
    }
}
</script>

