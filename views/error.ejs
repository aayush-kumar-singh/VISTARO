<% layout("/layouts/boilerplate") %>

<div class="row mt-5">

    <div class="col-8 offset-2">

        <div
            class="alert alert-danger"
            role="alert"
        >

            <h4 class="alert-heading">
                Something went wrong
            </h4>

            <hr>

            <p class="mb-0">
                <%= message %>
            </p>

        </div>

        <div class="text-center mt-4">

            <a
                href="/listings"
                class="btn btn-dark"
            >
                Back to Listings
            </a>

        </div>

    </div>

</div>