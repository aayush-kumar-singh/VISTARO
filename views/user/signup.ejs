<% layout("/layouts/boilerplate") %>

<div class="row mt-4 justify-content-center">

    <div class="col-12 col-md-8 col-lg-6">

        <h3 class="mb-4">
            Sign Up on Vistaro
        </h3>


        <!-- Signup form -->

        <form
            action="/signup"
            method="POST"
            novalidate
            class="needs-validation"
        >

            <!-- Username -->

            <div class="mt-3">

                <label
                    for="username"
                    class="form-label"
                >
                    Username
                </label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    class="form-control"
                    placeholder="Enter your username"
                    minlength="3"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a username.
                </div>

                <div class="valid-feedback">
                    Username looks good!
                </div>

            </div>


            <!-- Email -->

            <div class="mt-3">

                <label
                    for="email"
                    class="form-label"
                >
                    Email
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    class="form-control"
                    placeholder="Enter your email"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a valid email.
                </div>

                <div class="valid-feedback">
                    Email looks good!
                </div>

            </div>


            <!-- Password -->

            <div class="mt-3">

                <label
                    for="password"
                    class="form-label"
                >
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-control"
                    placeholder="Create a password"
                    minlength="6"
                    required
                >

                <div class="invalid-feedback">
                    Please enter a password.
                </div>

                <div class="valid-feedback">
                    Password looks good!
                </div>

            </div>


            <!-- Signup -->

            <button
                type="submit"
                class="btn btn-success mt-4"
            >
                Sign Up
            </button>

        </form>


        <!-- Divider -->

        <div class="text-center my-4">

            <span>OR</span>

        </div>


        <!-- Google authentication -->

        <a
            href="/auth/google"
            class="btn btn-outline-dark w-100"
        >
            <i class="fa-brands fa-google me-2"></i>
            Continue with Google
        </a>


        <!-- Login link -->

        <p class="text-center mt-4">

            Already have an account?

            <a href="/login">
                Log in
            </a>

        </p>

    </div>

</div>