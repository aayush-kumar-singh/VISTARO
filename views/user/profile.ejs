<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <!-- Profile Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center fw-bold fs-2" style="width: 70px; height: 70px;">
                    <%= user.username.charAt(0).toUpperCase() %>
                </div>
            </div>
            <div class="col">
                <h2 class="fw-bold mb-1"><%= user.username %></h2>
                <p class="text-muted mb-0">
                    <i class="fa-regular fa-envelope me-1"></i><%= user.email %>
                    <% if (user.googleId) { %>
                        <span class="badge bg-primary ms-2"><i class="fa-brands fa-google me-1"></i>Google Linked</span>
                    <% } %>
                </p>
            </div>
            <div class="col-auto text-end">
                <a href="/listings/new" class="btn add-btn btn-danger">
                    <i class="fa-solid fa-house-plus me-1"></i>List on Vistaro
                </a>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4" id="profileTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 me-2" id="upcoming-tab" data-bs-toggle="pill" data-bs-target="#upcoming" type="button" role="tab" aria-controls="upcoming" aria-selected="true">
                <i class="fa-solid fa-plane-departure me-1"></i>Upcoming Trips (<%= upcomingTrips.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 me-2" id="past-tab" data-bs-toggle="pill" data-bs-target="#past" type="button" role="tab" aria-controls="past" aria-selected="false">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>History (<%= pastTrips.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 me-2" id="hosted-tab" data-bs-toggle="pill" data-bs-target="#hosted" type="button" role="tab" aria-controls="hosted" aria-selected="false">
                <i class="fa-solid fa-house-chimney me-1"></i>My Listings (<%= hostedListings.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="incoming-tab" data-bs-toggle="pill" data-bs-target="#incoming" type="button" role="tab" aria-controls="incoming" aria-selected="false">
                <i class="fa-solid fa-calendar-check me-1"></i>Guest Bookings (<%= incomingBookings.length %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="settings-tab" data-bs-toggle="pill" data-bs-target="#settings" type="button" role="tab" aria-controls="settings" aria-selected="false">
                <i class="fa-solid fa-gear me-1"></i>Settings
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="profileTabContent">

        <!-- 1. Upcoming Trips -->
        <div class="tab-pane fade show active" id="upcoming" role="tabpanel" aria-labelledby="upcoming-tab">
            <% if (upcomingTrips && upcomingTrips.length > 0) { %>
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    <% for (const trip of upcomingTrips) { %>
                        <div class="col">
                            <div class="card shadow-sm rounded-4 border overflow-hidden h-100">
                                <div class="row g-0 h-100">
                                    <div class="col-md-5">
                                        <img src="<%= trip.listing ? trip.listing.image?.url : '' %>" class="img-fluid rounded-start h-100 w-100" style="object-fit: cover; min-height: 180px;" alt="trip image">
                                    </div>
                                    <div class="col-md-7 d-flex flex-column">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title fw-bold mb-0">
                                                    <%= trip.listing ? trip.listing.title : 'Listing Unavailable' %>
                                                </h5>
                                                <span class="badge bg-success">Confirmed</span>
                                            </div>
                                            <p class="text-muted small mb-2">
                                                <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                                <%= trip.listing ? trip.listing.location : '' %>, <%= trip.listing ? trip.listing.country : '' %>
                                            </p>
                                            <p class="small mb-1">
                                                <strong>Dates:</strong> <%= new Date(trip.checkIn).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %> &ndash; <%= new Date(trip.checkOut).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                            </p>
                                            <p class="small mb-1">
                                                <strong>Duration:</strong> <%= trip.nights %> night(s) &bull; <strong>Guests:</strong> <%= trip.guests || 1 %>
                                            </p>
                                            <p class="fw-bold fs-6 text-dark mt-2 mb-0">
                                                Total: <%= formatPrice(trip.totalPrice || 0) %>
                                            </p>
                                        </div>
                                        <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex justify-content-between align-items-center">
                                            <% if (trip.listing) { %>
                                                <a href="/listings/<%= trip.listing._id %>" class="btn btn-sm btn-outline-dark">
                                                    View Property
                                                </a>
                                            <% } %>
                                            <form method="POST" action="/bookings/<%= trip._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Cancel Stay
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="text-center py-5 border rounded-4 bg-light">
                    <i class="fa-solid fa-suitcase-rolling fs-1 text-muted mb-3 d-block"></i>
                    <h4>No upcoming trips booked... yet!</h4>
                    <p class="text-muted">Time to dust off your bags and start planning your next great adventure.</p>
                    <a href="/listings" class="btn add-btn btn-danger px-4 mt-2">Explore Destinations</a>
                </div>
            <% } %>
        </div>

        <!-- 2. Past Trips -->
        <div class="tab-pane fade" id="past" role="tabpanel" aria-labelledby="past-tab">
            <% if (pastTrips && pastTrips.length > 0) { %>
                <div class="row row-cols-1 row-cols-md-2 g-4">
                    <% for (const trip of pastTrips) { %>
                        <div class="col">
                            <div class="card shadow-sm rounded-4 border overflow-hidden h-100 opacity-75">
                                <div class="row g-0 h-100">
                                    <div class="col-md-5">
                                        <img src="<%= trip.listing ? trip.listing.image?.url : '' %>" class="img-fluid rounded-start h-100 w-100" style="object-fit: cover; min-height: 160px;" alt="trip image">
                                    </div>
                                    <div class="col-md-7 d-flex flex-column">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h5 class="card-title fw-bold mb-0">
                                                    <%= trip.listing ? trip.listing.title : 'Listing' %>
                                                </h5>
                                                <% if (trip.status === 'cancelled') { %>
                                                    <span class="badge bg-danger">Cancelled</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Completed</span>
                                                <% } %>
                                            </div>
                                            <p class="text-muted small mb-1">
                                                <%= new Date(trip.checkIn).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %> &ndash; <%= new Date(trip.checkOut).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %> (<%= trip.nights %> nights)
                                            </p>
                                            <p class="fw-bold small mb-1">
                                                Total Paid: <%= formatPrice(trip.totalPrice || 0) %>
                                            </p>
                                            <% if (trip.status === 'cancelled' && trip.cancellation) { %>
                                                <div class="bg-light p-2 rounded-3 small text-muted mb-2 border">
                                                    <div class="d-flex justify-content-between">
                                                        <span>Refund Processed:</span>
                                                        <strong class="text-success"><%= formatPrice(trip.cancellation.refundAmount || 0) %> (<%= trip.cancellation.refundPercentage || 0 %>%)</strong>
                                                    </div>
                                                    <% if (trip.cancellation.reason) { %>
                                                        <div class="small mt-1 text-truncate"><em>Reason: <%= trip.cancellation.reason %></em></div>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                            <% if (trip.listing) { %>
                                                <a href="/listings/<%= trip.listing._id %>" class="btn btn-sm btn-outline-dark mt-auto">
                                                    Visit Listing
                                                </a>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="text-center py-5 border rounded-4 bg-light">
                    <p class="text-muted mb-0">No past or cancelled trips in your history.</p>
                </div>
            <% } %>
        </div>

        <!-- 3. My Listings (Hosting) -->
        <div class="tab-pane fade" id="hosted" role="tabpanel" aria-labelledby="hosted-tab">
            <% if (hostedListings && hostedListings.length > 0) { %>
                <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
                    <% for (const item of hostedListings) { %>
                        <div class="col">
                            <div class="card listing-card shadow-sm rounded-4 border overflow-hidden h-100">
                                <img src="<%= item.image?.url %>" class="card-img-top" style="height: 180px; object-fit: cover;" alt="<%= item.title %>">
                                <div class="card-body p-3">
                                    <h5 class="card-title fw-bold mb-1"><%= item.title %></h5>
                                    <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= item.location %>, <%= item.country %></p>
                                    <p class="fw-bold mb-3"><%= formatPrice(item.price) %> <span class="text-muted fw-normal">/ night</span></p>
                                    <div class="d-flex gap-2">
                                        <a href="/listings/<%= item._id %>" class="btn btn-sm btn-outline-dark flex-grow-1">View</a>
                                        <a href="/listings/<%= item._id %>/edit" class="btn btn-sm btn-dark">Edit</a>
                                        <form method="POST" action="/listings/<%= item._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing permanently?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="text-center py-5 border rounded-4 bg-light">
                    <i class="fa-solid fa-house fs-1 text-muted mb-3 d-block"></i>
                    <h4>You haven't listed any properties yet</h4>
                    <p class="text-muted">Earn extra income and share your space by listing your home on Vistaro.</p>
                    <a href="/listings/new" class="btn add-btn btn-danger px-4 mt-2">Create a Listing</a>
                </div>
            <% } %>
        </div>

        <!-- 4. Incoming Guest Bookings -->
        <div class="tab-pane fade" id="incoming" role="tabpanel" aria-labelledby="incoming-tab">
            <% if (incomingBookings && incomingBookings.length > 0) { %>
                <div class="table-responsive bg-white rounded-4 shadow-sm border p-3">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Property</th>
                                <th>Guest</th>
                                <th>Guests</th>
                                <th>Dates</th>
                                <th>Duration</th>
                                <th>Payout</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const b of incomingBookings) { %>
                                <tr>
                                    <td>
                                        <strong><%= b.listing ? b.listing.title : 'Listing' %></strong>
                                    </td>
                                    <td>
                                        <i class="fa-regular fa-user me-1"></i>@<%= b.user ? b.user.username : 'guest' %>
                                    </td>
                                    <td>
                                        <i class="fa-solid fa-users me-1 text-muted"></i><%= b.guests || 1 %>
                                    </td>
                                    <td>
                                        <%= new Date(b.checkIn).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %> &ndash; <%= new Date(b.checkOut).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </td>
                                    <td><%= b.nights %> night(s)</td>
                                    <td class="fw-bold"><%= formatPrice(b.totalPrice || 0) %></td>
                                    <td>
                                        <% if (b.status === 'confirmed') { %>
                                            <span class="badge bg-success">Confirmed</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">Cancelled</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (b.status === 'confirmed') { %>
                                            <form method="POST" action="/bookings/<%= b._id %>?_method=DELETE" onsubmit="return confirm('Cancel this guest reservation?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-muted small">&mdash;</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5 border rounded-4 bg-light">
                    <i class="fa-solid fa-clipboard-list fs-1 text-muted mb-3 d-block"></i>
                    <h4>No guest reservations received yet</h4>
                    <p class="text-muted">When guests book your listed properties, their reservation details will appear here.</p>
                </div>
            <% } %>
        </div>

        <!-- 5. Settings Tab -->
        <div class="tab-pane fade" id="settings" role="tabpanel" aria-labelledby="settings-tab">
            <div class="row g-4">

                <!-- Bio / About -->
                <div class="col-12 col-md-6">
                    <div class="card border rounded-4 shadow-sm p-4">
                        <h5 class="fw-bold mb-3"><i class="fa-regular fa-id-badge me-2 text-danger"></i>About Me</h5>
                        <form method="POST" action="/profile/update">
                            <div class="mb-3">
                                <label for="bio" class="form-label small fw-bold">Bio <span class="text-muted fw-normal">(max 300 characters)</span></label>
                                <textarea
                                    id="bio"
                                    name="bio"
                                    class="form-control"
                                    rows="4"
                                    maxlength="300"
                                    placeholder="Tell hosts and guests a little about yourself..."
                                ><%= user.bio || '' %></textarea>
                                <div class="form-text text-end" id="bioCount">0 / 300</div>
                            </div>
                            <button type="submit" class="btn btn-dark rounded-pill px-4">Save Bio</button>
                        </form>
                    </div>
                </div>

                <!-- Change Password -->
                <% if (!user.googleId) { %>
                <div class="col-12 col-md-6">
                    <div class="card border rounded-4 shadow-sm p-4">
                        <h5 class="fw-bold mb-3"><i class="fa-solid fa-lock me-2 text-danger"></i>Change Password</h5>
                        <form method="POST" action="/profile/change-password">
                            <div class="mb-3">
                                <label for="currentPassword" class="form-label small fw-bold">Current Password</label>
                                <input type="password" id="currentPassword" name="currentPassword" class="form-control" required autocomplete="current-password">
                            </div>
                            <div class="mb-3">
                                <label for="newPassword" class="form-label small fw-bold">New Password</label>
                                <input type="password" id="newPassword" name="newPassword" class="form-control" required minlength="6" autocomplete="new-password">
                                <div class="form-text">Minimum 6 characters.</div>
                            </div>
                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label small fw-bold">Confirm New Password</label>
                                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required autocomplete="new-password">
                            </div>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">Update Password</button>
                        </form>
                    </div>
                </div>
                <% } else { %>
                <div class="col-12 col-md-6">
                    <div class="card border rounded-4 shadow-sm p-4 bg-light">
                        <h5 class="fw-bold mb-2"><i class="fa-brands fa-google me-2 text-primary"></i>Google Account</h5>
                        <p class="text-muted small mb-0">Your account is linked to Google. Password changes are managed through Google.</p>
                    </div>
                </div>
                <% } %>

            </div>
        </div>

    </div>

</div>

<script>
    // 1.4: Bio character counter
    var bioEl = document.getElementById('bio');
    var bioCount = document.getElementById('bioCount');
    if (bioEl && bioCount) {
        function updateBioCount() { bioCount.textContent = bioEl.value.length + ' / 300'; }
        updateBioCount();
        bioEl.addEventListener('input', updateBioCount);
    }

    // 1.4: Auto-switch to Settings tab if URL fragment is #settings
    if (window.location.hash === '#settings') {
        var settingsTab = document.getElementById('settings-tab');
        if (settingsTab) {
            var pill = new bootstrap.Tab(settingsTab);
            pill.show();
        }
    }
</script>
