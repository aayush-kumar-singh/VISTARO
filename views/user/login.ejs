<% layout("/layouts/boilerplate") %>

<div class="row mt-4 justify-content-center">

    <div class="col-12 col-md-8 col-lg-6">

        <h3 class="mb-4">
            Login
        </h3>


        <!-- Local login form -->

        <form
            action="/login"
            method="POST"
            novalidate
            class="needs-validation"
        >

            <!-- Username -->

            <div class="mt-3">

                <label
                    for="username"
                    class="form-label"
                >
                    Username
                </label>

                <input
                    type="text"
                    id="username"
                    name="username"
                    class="form-control"
                    placeholder="Enter your username"
                    required
                >

                <div class="invalid-feedback">
                    Please enter your username.
                </div>

            </div>


            <!-- Password -->

            <div class="mt-3">

                <label
                    for="password"
                    class="form-label"
                >
                    Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-control"
                    placeholder="Enter your password"
                    required
                >

                <div class="invalid-feedback">
                    Please enter your password.
                </div>

            </div>


            <!-- Login -->

            <button
                type="submit"
                class="btn btn-success mt-4"
            >
                Login
            </button>

        </form>


        <!-- Divider -->

        <div class="text-center my-4">

            <span>OR</span>

        </div>


        <!-- Google login -->

        <a
            href="/auth/google"
            class="btn btn-outline-dark w-100"
        >
            <i class="fa-brands fa-google me-2"></i>
            Continue with Google
        </a>


        <!-- Signup link -->

        <p class="text-center mt-4">

            Don't have an account?

            <a href="/signup">
                Sign up
            </a>

        </p>

    </div>

</div>