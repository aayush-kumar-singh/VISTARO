        background-color: var(--color-surface) !important;
        border-bottom: 1px solid var(--color-border) !important;
        position: sticky !important;
        top: 0 !important;
        z-index: 1030 !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }

    /* Child 1 — .navbar-left */
