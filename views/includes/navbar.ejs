<nav class="navbar custom-navbar">

    <!-- Child 1 — .navbar-left (flex: 0 0 auto) -->
    <div class="navbar-left">
        <a class="navbar-brand-link" href="/listings">
            <!-- Vistaro SVG Logo: V-shaped rooftop + location pin drop -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 44 44" width="36" height="36" aria-hidden="true" focusable="false">
                <path d="M22 4C15.373 4 10 9.373 10 16c0 9 12 24 12 24s12-15 12-24c0-6.627-5.373-12-12-12z" fill="var(--color-primary)"/>
                <polyline points="16,13 22,20 28,13" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="22" cy="16" r="3.5" fill="white" opacity="0.9"/>
            </svg>
            <span class="brand-text">
                Vis<span style="color: var(--color-primary);">taro</span>
            </span>
        </a>

        <a class="nav-explore d-none d-md-inline-flex" href="/listings">Explore</a>
    </div>


    <!-- Child 2 — .navbar-search (flex: 1 1 auto, max-width: 480px, margin: 0 auto) -->
    <div class="navbar-search d-none d-md-flex">
        <form class="search-form" method="GET" action="/search">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>

            <input
                class="search-input"
                type="search"
                placeholder="Start your search"
                aria-label="Search"
                name="q"
                value="<%= typeof query !== 'undefined' ? query : '' %>"
                required
            >

            <button
                class="search-btn rounded-circle"
                type="submit"
                aria-label="Search"
            >
                <i class="fa-solid fa-arrow-right" style="font-size: 0.8rem;"></i>
            </button>
        </form>
    </div>


    <!-- Child 3 — .navbar-right (flex: 0 0 auto, gap: var(--space-5)) -->
    <div class="navbar-right d-none d-md-flex">

        <a class="nav-item-link" href="/listings/new" title="List on Vistaro">
            <i class="fa-solid fa-house-plus text-danger me-1"></i>
            <span class="nav-text-list">List on Vistaro</span>
        </a>

        <!-- Currency Switcher Dropdown -->
        <% if (typeof availableCurrencies !== "undefined") { %>
            <div class="dropdown d-inline-flex align-items-center">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: var(--text-sm);">
                    <i class="fa-solid fa-globe me-1"></i><%= currCurrency || "INR" %> (<%= availableCurrencies[currCurrency]?.symbol || "₹" %>)
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3">
                    <% for (const key in availableCurrencies) { %>
                        <% const c = availableCurrencies[key]; %>
                        <li>
                            <a class="dropdown-item d-flex justify-content-between align-items-center <%= currCurrency === c.code ? 'active fw-bold' : '' %>" href="/currency/<%= c.code %>">
                                <span><%= c.name %> (<%= c.code %>)</span>
                                <span class="badge bg-light text-dark ms-2"><%= c.symbol %></span>
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        <% } %>

        <% if (!currUser) { %>
            <a class="nav-item-link" href="/signup">Sign Up</a>
            <a class="btn-login" href="/login">Log In</a>
        <% } %>

        <% if (currUser) { %>
            <a class="nav-item-link position-relative" href="/inbox">
                <i class="fa-regular fa-message text-dark me-1"></i>Messages
                <% if (typeof unreadCount !== "undefined" && unreadCount > 0) { %>
                    <span class="position-absolute top-1 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                        <span class="visually-hidden">Unread messages</span>
                    </span>
                <% } %>
            </a>

            <a class="nav-item-link" href="/owner/dashboard">
                <i class="fa-solid fa-chart-line text-dark me-1"></i>Dashboard
            </a>

            <a class="nav-item-link" href="/wishlist">
                <i class="fa-solid fa-heart text-danger me-1"></i>Wishlist
            </a>

            <a class="nav-item-link" href="/profile">
                <i class="fa-regular fa-user me-1"></i><b><%= currUser.username %></b>
            </a>

            <a class="btn-logout" href="/logout">Log Out</a>
        <% } %>

    </div>

    <!-- Mobile Nav Controls (<768px): Search trigger + Hamburger dropdown -->
    <div class="navbar-mobile-controls d-flex d-md-none align-items-center gap-2">
        <button class="btn btn-light rounded-circle p-2 mobile-search-toggle" type="button" aria-label="Open Search" id="mobileSearchOpenBtn">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>

        <div class="dropdown">
            <button class="btn btn-outline-secondary rounded-pill px-3 py-2 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu">
                <i class="fa-solid fa-bars"></i>
                <i class="fa-solid fa-user-circle fs-5"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 p-2 mt-2" style="min-width: 220px;">
                <li><a class="dropdown-item py-2 fw-semibold" href="/listings"><i class="fa-solid fa-compass me-2"></i>Explore</a></li>
                <li><a class="dropdown-item py-2 fw-semibold" href="/listings/new"><i class="fa-solid fa-house-plus text-danger me-2"></i>List on Vistaro</a></li>
                <li><hr class="dropdown-divider"></li>
                <% if (!currUser) { %>
                    <li><a class="dropdown-item py-2 fw-bold text-danger" href="/signup">Sign Up</a></li>
                    <li><a class="dropdown-item py-2" href="/login">Log In</a></li>
                <% } else { %>
                    <li><a class="dropdown-item py-2" href="/inbox"><i class="fa-regular fa-message me-2"></i>Messages</a></li>
                    <li><a class="dropdown-item py-2" href="/owner/dashboard"><i class="fa-solid fa-chart-line me-2"></i>Dashboard</a></li>
                    <li><a class="dropdown-item py-2" href="/wishlist"><i class="fa-solid fa-heart text-danger me-2"></i>Wishlist</a></li>
                    <li><a class="dropdown-item py-2" href="/profile"><i class="fa-regular fa-user me-2"></i><%= currUser.username %></a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Log Out</a></li>
                <% } %>
            </ul>
        </div>
    </div>

</nav>

<!-- Mobile Fullscreen Search Overlay (<768px) -->
<div id="mobileSearchOverlay" class="mobile-search-overlay d-md-none">
    <div class="mobile-search-dialog">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-bold fs-5">Where to?</span>
            <button type="button" class="btn-close" id="mobileSearchCloseBtn" aria-label="Close"></button>
        </div>
        <form method="GET" action="/search" class="w-100">
            <div class="input-group search-input-group shadow-sm rounded-pill overflow-hidden border">
                <span class="input-group-text bg-white border-0 ps-3">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input
                    type="search"
                    name="q"
                    class="form-control border-0 py-3 ps-2"
                    placeholder="Search destinations, villas, cabins..."
                    value="<%= typeof query !== 'undefined' ? query : '' %>"
                    style="font-size: var(--text-base);"
                    autofocus
                    required
                >
                <button class="btn btn-danger px-4 fw-semibold" type="submit">Search</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const openBtn = document.getElementById("mobileSearchOpenBtn");
        const closeBtn = document.getElementById("mobileSearchCloseBtn");
        const overlay = document.getElementById("mobileSearchOverlay");

        if (openBtn && overlay) {
            openBtn.addEventListener("click", function () {
                overlay.classList.add("active");
                const input = overlay.querySelector("input");
                if (input) setTimeout(() => input.focus(), 150);
            });
        }
        if (closeBtn && overlay) {
            closeBtn.addEventListener("click", function () {
                overlay.classList.remove("active");
            });
        }
    });
</script>

<style>
    /* =====================================================================
       PART 1 — NAVBAR EXACT SPEC
    ===================================================================== */
