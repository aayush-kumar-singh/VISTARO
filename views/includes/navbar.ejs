        max-width: 600px;
        margin: var(--space-4) auto;
        border-radius: var(--radius-md);
        padding: var(--space-5);
        box-shadow: var(--shadow-lg);
        animation: fadeInDown 0.2s ease;
    }

    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

