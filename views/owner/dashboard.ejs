<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <!-- Header & Action -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fa-solid fa-chart-line text-danger me-2"></i>Host & Owner Dashboard
            </h2>
            <p class="text-muted mb-0">Manage your properties, track earnings, and review incoming guest reservations.</p>
        </div>
        <a href="/listings/new" class="btn btn-dark rounded-pill px-4">
            <i class="fa-solid fa-plus me-1"></i>Add New Listing
        </a>
    </div>

    <!-- KPI Summary Metric Cards -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3 mb-4">
        
        <!-- 1. Total Properties -->
        <div class="col">
            <div class="card border rounded-4 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Properties</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0"><%= myListings ? myListings.length : 0 %></h3>
                    </div>
                    <div class="p-3 bg-light rounded-circle text-danger fs-5">
                        <i class="fa-solid fa-house"></i>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block">Active published stays</small>
            </div>
        </div>

        <!-- 2. Gross Revenue -->
        <div class="col">
            <div class="card border rounded-4 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Total Revenue</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">&#8377; <%= totalRevenue.toLocaleString('en-IN') %></h3>
                    </div>
                    <div class="p-3 bg-light rounded-circle text-success fs-5">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block">From confirmed reservations</small>
            </div>
        </div>

        <!-- 3. Upcoming Guests -->
        <div class="col">
            <div class="card border rounded-4 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">Upcoming Guests</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0"><%= totalGuests %></h3>
                    </div>
                    <div class="p-3 bg-light rounded-circle text-primary fs-5">
                        <i class="fa-solid fa-user-group"></i>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block"><%= upcomingBookings.length %> upcoming trip(s)</small>
            </div>
        </div>

        <!-- 4. 30-Day Occupancy Rate -->
        <div class="col">
            <div class="card border rounded-4 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-muted small fw-bold text-uppercase">30-Day Occupancy</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0"><%= occupancyRate %>%</h3>
                    </div>
                    <div class="p-3 bg-light rounded-circle text-warning fs-5">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block">Next 30 days booked ratio</small>
            </div>
        </div>

    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs mb-4" id="dashboardTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold text-dark" id="listings-tab" data-bs-toggle="tab" data-bs-target="#listings-tab-pane" type="button" role="tab" aria-controls="listings-tab-pane" aria-selected="true">
                <i class="fa-solid fa-list me-1 text-danger"></i>My Listings (<%= myListings ? myListings.length : 0 %>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold text-dark" id="reservations-tab" data-bs-toggle="tab" data-bs-target="#reservations-tab-pane" type="button" role="tab" aria-controls="reservations-tab-pane" aria-selected="false">
                <i class="fa-solid fa-calendar-days me-1 text-primary"></i>Guest Reservations (<%= incomingBookings ? incomingBookings.length : 0 %>)
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="dashboardTabContent">

        <!-- 1. My Listings Tab -->
        <div class="tab-pane fade show active" id="listings-tab-pane" role="tabpanel" aria-labelledby="listings-tab" tabindex="0">
            <% if (listingStats && listingStats.length > 0) { %>
                <div class="table-responsive bg-white rounded-4 shadow-sm border p-3">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Property</th>
                                <th>Location</th>
                                <th>Price / Night</th>
                                <th>Policy</th>
                                <th>Bookings</th>
                                <th>Revenue</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const stat of listingStats) { %>
                                <% const l = stat.listing; %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img
                                                src="<%= l.images?.[0]?.url || l.image?.url %>"
                                                alt="<%= l.title %>"
                                                class="rounded-3 shadow-sm"
                                                style="width: 55px; height: 45px; object-fit: cover;"
                                            >
                                            <div>
                                                <a href="/listings/<%= l._id %>" class="text-dark fw-bold text-decoration-none">
                                                    <%= l.title %>
                                                </a>
                                                <small class="text-muted d-block"><%= l.category %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><%= l.location %>, <%= l.country %></td>
                                    <td class="fw-bold">&#8377; <%= l.price.toLocaleString('en-IN') %></td>
                                    <td>
                                        <span class="badge bg-light text-dark border text-capitalize"><%= l.cancellationPolicy || 'flexible' %></span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary rounded-pill"><%= stat.confirmedBookings %> active</span>
                                        <% if (stat.upcomingBookings > 0) { %>
                                            <small class="text-success d-block fw-semibold">(<%= stat.upcomingBookings %> upcoming)</small>
                                        <% } %>
                                    </td>
                                    <td class="fw-bold text-success">&#8377; <%= stat.revenue.toLocaleString('en-IN') %></td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/listings/<%= l._id %>" class="btn btn-outline-secondary" title="View Property">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>
                                            <a href="/listings/<%= l._id %>/edit" class="btn btn-outline-dark" title="Edit Listing">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>
                                            <form method="POST" action="/listings/<%= l._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to permanently delete this listing?');" class="d-inline">
                                                <button type="submit" class="btn btn-outline-danger" title="Delete Listing">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5 border rounded-4 bg-light">
                    <i class="fa-solid fa-house-chimney-medical fs-1 text-muted mb-3 d-block"></i>
                    <h4>You have no properties listed yet</h4>
                    <p class="text-muted">Start hosting your villa, farm, or apartment and welcome travelers worldwide.</p>
                    <a href="/listings/new" class="btn btn-dark rounded-pill px-4 mt-2">
                        Create Your First Listing
                    </a>
                </div>
            <% } %>
        </div>

        <!-- 2. Guest Reservations Tab -->
        <div class="tab-pane fade" id="reservations-tab-pane" role="tabpanel" aria-labelledby="reservations-tab" tabindex="0">
            <% if (incomingBookings && incomingBookings.length > 0) { %>
                <div class="table-responsive bg-white rounded-4 shadow-sm border p-3">
                    <table class="table align-middle table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Property</th>
                                <th>Guest</th>
                                <th>Guests</th>
                                <th>Dates</th>
                                <th>Duration</th>
                                <th>Payout</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (const b of incomingBookings) { %>
                                <tr>
                                    <td>
                                        <strong><%= b.listing ? b.listing.title : 'Listing' %></strong>
                                    </td>
                                    <td>
                                        <i class="fa-regular fa-user me-1"></i>@<%= b.user ? b.user.username : 'guest' %>
                                    </td>
                                    <td>
                                        <i class="fa-solid fa-users me-1 text-muted"></i><%= b.guests || 1 %>
                                    </td>
                                    <td>
                                        <%= new Date(b.checkIn).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %> &ndash; <%= new Date(b.checkOut).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </td>
                                    <td><%= b.nights %> night(s)</td>
                                    <td class="fw-bold text-success">&#8377; <%= b.totalPrice ? b.totalPrice.toLocaleString('en-IN') : '0' %></td>
                                    <td>
                                        <% if (b.status === 'confirmed') { %>
                                            <span class="badge bg-success">Confirmed</span>
                                        <% } else { %>
                                            <span class="badge bg-danger">Cancelled</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <% if (b.status === 'confirmed') { %>
                                            <form method="POST" action="/bookings/<%= b._id %>?_method=DELETE" onsubmit="return confirm('Cancel this guest reservation?');" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-muted small">&ndash;</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5 border rounded-4 bg-light">
                    <i class="fa-regular fa-calendar-xmark fs-1 text-muted mb-3 d-block"></i>
                    <h4>No guest reservations yet</h4>
                    <p class="text-muted">When travelers book your stays, all reservation dates and details will appear here.</p>
                </div>
            <% } %>
        </div>

    </div>

</div>
