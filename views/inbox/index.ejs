<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <div class="row g-0 bg-white rounded-4 shadow border overflow-hidden" style="min-height: 600px; height: 75vh;">

        <!-- Left Sidebar: Conversations List -->
        <div class="col-md-4 col-12 border-end d-flex flex-column h-100 bg-light">
            <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <i class="fa-regular fa-comments text-danger me-2"></i>Messages
                </h5>
                <span class="badge bg-dark rounded-pill"><%= conversations ? conversations.length : 0 %></span>
            </div>

            <div class="overflow-auto flex-grow-1">
                <% if (conversations && conversations.length > 0) { %>
                    <div class="list-group list-group-flush">
                        <% for (const conv of conversations) { %>
                            <% 
                                const otherUser = conv.participants.find(p => !p._id.equals(currUser._id));
                                const isActive = activeConversation && activeConversation._id.equals(conv._id);
                            %>
                            <a
                                href="/inbox/<%= conv._id %>"
                                class="list-group-item list-group-item-action p-3 <%= isActive ? 'bg-white border-start border-3 border-danger' : '' %>"
                            >
                                <div class="d-flex align-items-center gap-3">
                                    <img
                                        src="<%= conv.listing ? (conv.listing.images?.[0]?.url || conv.listing.image?.url) : '' %>"
                                        alt="Listing"
                                        class="rounded-3 shadow-sm"
                                        style="width: 50px; height: 50px; object-fit: cover;"
                                    >
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                                            <strong class="text-truncate d-block" style="max-width: 140px;">
                                                @<%= otherUser ? otherUser.username : 'User' %>
                                            </strong>
                                            <small class="text-muted" style="font-size: 0.75rem;">
                                                <%= new Date(conv.updatedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %>
                                            </small>
                                        </div>
                                        <p class="small text-muted mb-0 text-truncate">
                                            <%= conv.listing ? conv.listing.title : 'Listing' %>
                                        </p>
                                    </div>
                                </div>
                            </a>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5 px-3 text-muted">
                        <i class="fa-regular fa-envelope-open fs-1 mb-3 text-secondary d-block"></i>
                        <h6>No conversations yet</h6>
                        <p class="small mb-0">When you message a host or receive an inquiry, it will appear here.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Right Pane: Active Chat Window -->
        <div class="col-md-8 col-12 d-flex flex-column h-100 bg-white">
            <% if (activeConversation && recipient) { %>
                <!-- Chat Header -->
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-white shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px;">
                            <%= recipient.username.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">@<%= recipient.username %></h6>
                            <% if (activeConversation.listing) { %>
                                <a href="/listings/<%= activeConversation.listing._id %>" class="small text-danger text-decoration-none" target="_blank">
                                    <i class="fa-solid fa-house-chimney me-1"></i><%= activeConversation.listing.title %>
                                </a>
                            <% } %>
                        </div>
                    </div>
                    <% if (activeConversation.listing) { %>
                        <a href="/listings/<%= activeConversation.listing._id %>" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                            View Listing
                        </a>
                    <% } %>
                </div>

                <!-- Messages Container -->
                <div class="flex-grow-1 p-3 overflow-auto d-flex flex-column gap-3 bg-light" id="messagesContainer">
                    <% if (messages && messages.length > 0) { %>
                        <% for (const msg of messages) { %>
                            <% const isMe = msg.sender && msg.sender._id.equals(currUser._id); %>
                            <div class="d-flex <%= isMe ? 'justify-content-end' : 'justify-content-start' %>">
                                <div class="p-3 rounded-4 shadow-sm <%= isMe ? 'bg-dark text-white rounded-bottom-end-0' : 'bg-white text-dark rounded-bottom-start-0 border' %>" style="max-width: 70%; word-break: break-word;">
                                    <p class="mb-1"><%= msg.body %></p>
                                    <div class="d-flex justify-content-end align-items-center gap-1">
                                        <small class="<%= isMe ? 'text-white-50' : 'text-muted' %>" style="font-size: 0.7rem;">
                                            <%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="text-center my-auto py-4 text-muted">
                            <i class="fa-regular fa-comment-dots fs-1 mb-2 d-block"></i>
                            <p class="small mb-0">Start the conversation! Send a message regarding your stay.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Message Input Footer -->
                <div class="p-3 border-top bg-white">
                    <form id="chatForm" class="d-flex gap-2">
                        <input
                            type="text"
                            id="messageInput"
                            name="body"
                            class="form-control rounded-pill px-3"
                            placeholder="Type a message to @<%= recipient.username %>..."
                            autocomplete="off"
                            required
                        >
                        <button type="submit" class="btn btn-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>

            <% } else { %>
                <!-- Empty State -->
                <div class="d-flex flex-column align-items-center justify-content-center h-100 p-4 text-center text-muted">
                    <div class="p-4 bg-light rounded-circle mb-3 text-danger fs-1">
                        <i class="fa-regular fa-comment-dots"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Your Messages</h4>
                    <p class="text-muted" style="max-width: 320px;">
                        Select a conversation from the sidebar to chat with guests and hosts in real-time.
                    </p>
                </div>
            <% } %>
        </div>

    </div>

</div>

<!-- Socket.io Real-Time Client Script -->
<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const messagesContainer = document.getElementById("messagesContainer");
        if (messagesContainer) {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        <% if (activeConversation) { %>
            const conversationId = "<%= activeConversation._id %>";
            const currUserId = "<%= currUser._id %>";
            const currUsername = "<%= currUser.username %>";

            const socket = io();

            socket.emit("join_conversation", conversationId);

            // Listen for incoming live chat messages
            socket.on("new_message", (data) => {
                if (data.conversationId === conversationId) {
                    const isMe = data.senderId === currUserId;
                    
                    // Avoid duplicating message if already added locally
                    if (!isMe) {
                        appendMessage(data.body, false, data.createdAt);
                    }
                }
            });

            function appendMessage(body, isMe, timeStr) {
                if (!messagesContainer) return;

                const time = timeStr ? new Date(timeStr).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                
                const wrapper = document.createElement("div");
                wrapper.className = `d-flex ${isMe ? 'justify-content-end' : 'justify-content-start'}`;
                
                wrapper.innerHTML = `
                    <div class="p-3 rounded-4 shadow-sm ${isMe ? 'bg-dark text-white rounded-bottom-end-0' : 'bg-white text-dark rounded-bottom-start-0 border'}" style="max-width: 70%; word-break: break-word;">
                        <p class="mb-1">${escapeHtml(body)}</p>
                        <div class="d-flex justify-content-end align-items-center gap-1">
                            <small class="${isMe ? 'text-white-50' : 'text-muted'}" style="font-size: 0.7rem;">${time}</small>
                        </div>
                    </div>
                `;

                messagesContainer.appendChild(wrapper);
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }

            function escapeHtml(str) {
                const div = document.createElement("div");
                div.textContent = str;
                return div.innerHTML;
            }

            const chatForm = document.getElementById("chatForm");
            const messageInput = document.getElementById("messageInput");

            if (chatForm && messageInput) {
                chatForm.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    const text = messageInput.value.trim();
                    if (!text) return;

                    messageInput.value = "";

                    // Optimistically append message to chat
                    appendMessage(text, true, new Date().toISOString());

                    try {
                        // Persist to MongoDB backend
                        const res = await fetch(`/inbox/${conversationId}/messages`, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "Accept": "application/json"
                            },
                            body: JSON.stringify({ body: text })
                        });

                        if (res.ok) {
                            // Emit to other room participants via Socket.io
                            socket.emit("send_message", {
                                conversationId,
                                senderId: currUserId,
                                senderUsername: currUsername,
                                body: text,
                                createdAt: new Date().toISOString()
                            });
                        }
                    } catch (err) {
                        console.error("Failed to send message:", err);
                    }
                });
            }
        <% } %>
    });
</script>
