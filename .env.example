# ==========================================
# VISTARO — ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port (Default: 3003)
PORT=3003

# MongoDB Atlas Connection URL
ATLAS_DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vistaro?retryWrites=true&w=majority
# (Or local MongoDB: mongodb://127.0.0.1:27017/vistaro)

# Express Session Encryption Key
SESSION_SECRET=your_super_secret_session_key_here

# Cloudinary (Media Uploads & Storage)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Geoapify Geocoding API (Automatic coordinate generation)
GEOAPIFY_API_KEY=your_geoapify_api_key

# Google OAuth 2.0 (Optional: One-click sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3003/api/auth/google/callback

# Nodemailer (Booking Confirmation & Cancellation Receipts)
# Note: Defaults to Ethereal test account if credentials are not specified
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend Client URL (For CORS & OAuth redirects)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
